# =============================================================================
# Root environment file for docker-compose (copy to .env and fill in values).
#
#   cp .env.example .env
#
# docker-compose.yml fails fast (via ${VAR:?...}) if any REQUIRED secret below
# is missing, so the stack will refuse to start until they are set.
# Per-app local development (running server/ and client/ directly) uses the
# separate server/.env and client/.env files — see their .env.example siblings.
# =============================================================================

# -----------------------------------------------------------------------------
# Database (MySQL) — REQUIRED
# -----------------------------------------------------------------------------
# Root password for the MySQL container (used by healthcheck too).
MYSQL_ROOT_PASSWORD=
# Application database credentials.
MYSQL_PASSWORD=
# Optional (defaults shown):
MYSQL_DATABASE=restaurante
MYSQL_USER=restaurant_user
# Host port to expose MySQL on (container port is always 3306).
MYSQL_PORT=3306

# Composed automatically inside docker-compose from the values above; you do not
# normally set DATABASE_URL here. For non-docker local dev set it in server/.env:
#   DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DATABASE"

# -----------------------------------------------------------------------------
# Auth / Security — REQUIRED
# -----------------------------------------------------------------------------
# Long random string. The server refuses to boot if this is missing or set to a
# known-weak default like "change-me-in-production".
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Encryption key for TOTP and integration secrets at rest (64-char hex = 256 bits).
# REQUIRED in production; the server refuses to boot without a valid key.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TWO_FA_ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# Server runtime
# -----------------------------------------------------------------------------
NODE_ENV=production
# Canonical application port. The server listens on 3000 inside the container and
# docker-compose maps SERVER_PORT (host) -> 3000 (container).
SERVER_PORT=3000
# Hard deadline for PedidosYa outbound requests (250..60000 ms).
PEDIDOSYA_HTTP_TIMEOUT_MS=8000
# Internal DB deadline for readiness probes (50..10000 ms).
READINESS_DB_TIMEOUT_MS=2000
# Filesystem/shared-identity deadline (100..10000 ms). Timed-out requests reuse
# one in-flight probe instead of starting parallel storage operations.
READINESS_STORAGE_TIMEOUT_MS=2000
# Readiness also checks the face provider when an active attendance policy
# requires biometrics in an attendance-enabled branch.
READINESS_BIOMETRIC_TIMEOUT_MS=2000
# CORS / frontend origin(s), comma-separated. Passed into the server service.
CLIENT_URL=http://localhost:5173

# Facial verification. Keep disabled unless a real HTTPS provider is configured.
HR_FACE_PROVIDER=disabled
HR_ALLOW_FAKE_FACE_PROVIDER=false
HR_FACE_PROVIDER_BASE_URL=
# Active outbound token used by the API. During rotation, set this to the new
# token and configure FACE_AUTH_TOKENS below with "new,previous".
HR_FACE_PROVIDER_TOKEN=
# Required with the HTTP provider in production. These values must match the
# authenticated provider /health response exactly.
HR_FACE_PROVIDER_MODEL=
HR_FACE_PROVIDER_VERSION=
HR_FACE_PROVIDER_TIMEOUT_MS=5000
HR_FACE_PROVIDER_ALLOW_HTTP_INTERNAL=false
HR_BIOMETRIC_ENCRYPTION_KEY=
# Secrets owned by the optional self-hosted provider. Generate two different
# 64-character hex keys. By default FACE_AUTH_TOKENS falls back to
# HR_FACE_PROVIDER_TOKEN; set it explicitly to "active,previous" only during a
# bounded rotation window, then remove the previous token.
FACE_AUTH_TOKENS=
FACE_TEMPLATE_ENCRYPTION_KEY=
FACE_IDENTIFIER_HASH_KEY=
FACE_PROVIDER_PORT=8081

# -----------------------------------------------------------------------------
# Client (Vite) — baked at build/runtime
# -----------------------------------------------------------------------------
CLIENT_PORT=5173
VITE_API_URL=http://localhost:3000/api
VITE_WS_URL=ws://localhost:3000

# -----------------------------------------------------------------------------
# Swagger API docs basic-auth (production)
# -----------------------------------------------------------------------------
# In production /api/docs is disabled (HTTP 503) unless DOCS_PASSWORD is set.
DOCS_USER=admin
DOCS_PASSWORD=

# Optional global backup API operator. Leave empty to disable the API. Because a
# physical dump contains every tenant, only SUPERADMIN users from this company
# may create/list/download/delete backups.
BACKUP_ADMIN_COMPANY_ID=

# Required in production. `single` pins every actor to its own company and
# disables cross-tenant operations. `multi` requires PLATFORM_ADMIN_COMPANY_ID.
PLATFORM_TENANCY_MODE=single

# In `multi` mode, only a primary-role SUPERADMIN from this company may manage
# the companies registry or use cross-tenant companyId overrides. Leave empty
# in `single` mode. Missing/invalid configuration always fails closed.
PLATFORM_ADMIN_COMPANY_ID=

# Durable API files. Development may leave both values empty. Production
# requires an absolute durable path and one stable deployment identity; every
# replica using the same MySQL database must mount the same physical volume.
STORAGE_DIR=
STORAGE_SHARED_ID=

# =============================================================================
# Root environment file for docker-compose (copy to .env and fill in values).
#
#   cp .env.example .env
#
# docker-compose.yml fails fast (via ${VAR:?...}) if any REQUIRED secret below
# is missing, so the stack will refuse to start until they are set.
# Per-app local development (running server/ and client/ directly) uses the
# separate server/.env and client/.env files — see their .env.example siblings.
# =============================================================================

# -----------------------------------------------------------------------------
# Database (MySQL) — REQUIRED
# -----------------------------------------------------------------------------
# Root password for the MySQL container (used by healthcheck too).
MYSQL_ROOT_PASSWORD=
# Application database credentials.
MYSQL_PASSWORD=
# Optional (defaults shown):
MYSQL_DATABASE=restaurante
MYSQL_USER=restaurant_user
# Host port to expose MySQL on (container port is always 3306).
MYSQL_PORT=3306

# Composed automatically inside docker-compose from the values above; you do not
# normally set DATABASE_URL here. For non-docker local dev set it in server/.env:
#   DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DATABASE"

# -----------------------------------------------------------------------------
# Auth / Security — REQUIRED
# -----------------------------------------------------------------------------
# Long random string. The server refuses to boot if this is missing or set to a
# known-weak default like "change-me-in-production".
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Encryption key for TOTP and integration secrets at rest (64-char hex = 256 bits).
# REQUIRED in production; the server refuses to boot without a valid key.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TWO_FA_ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# Server runtime
# -----------------------------------------------------------------------------
NODE_ENV=production
# Canonical application port. The server listens on 3000 inside the container and
# docker-compose maps SERVER_PORT (host) -> 3000 (container).
SERVER_PORT=3000
# CORS / frontend origin(s), comma-separated. Passed into the server service.
CLIENT_URL=http://localhost:5173

# -----------------------------------------------------------------------------
# Client (Vite) — baked at build/runtime
# -----------------------------------------------------------------------------
CLIENT_PORT=5173
VITE_API_URL=http://localhost:3000/api
VITE_WS_URL=ws://localhost:3000

# -----------------------------------------------------------------------------
# Swagger API docs basic-auth (production)
# -----------------------------------------------------------------------------
# In production /api/docs is disabled (HTTP 503) unless DOCS_PASSWORD is set.
DOCS_USER=admin
DOCS_PASSWORD=

# Optional global backup API operator. Leave empty to disable the API. Because a
# physical dump contains every tenant, only SUPERADMIN users from this company
# may create/list/download/delete backups.
BACKUP_ADMIN_COMPANY_ID=

# Durable API files. Native execution defaults to the server working directory.
# Container/Railway deployments should mount a persistent volume at /app/storage.
STORAGE_DIR=

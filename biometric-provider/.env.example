FACE_ENV=development
# Comma-separated accepted tokens support a bounded rotation window. The caller
# must send one active token, never the comma-separated list as a Bearer value.
FACE_AUTH_TOKENS=replace-with-at-least-32-random-characters
FACE_TEMPLATE_ENCRYPTION_KEY=replace-with-64-hex-characters
FACE_IDENTIFIER_HASH_KEY=replace-with-another-64-hex-characters
FACE_DATABASE_URL=sqlite:///./data/biometric-templates.db
FACE_MODELS_DIR=./models
FACE_MODEL_NAME=yunet-sface-minifas-v1
FACE_MAX_REQUEST_BYTES=18000000
FACE_MAX_FRAME_BYTES=2097152
FACE_MAX_CONCURRENCY=1
FACE_QUEUE_TIMEOUT_SECONDS=0.5
FACE_MAX_FRAMES=6
FACE_MIN_LIVENESS_FRAMES=4
FACE_MATCH_THRESHOLD=0.45
FACE_PASSIVE_LIVENESS_THRESHOLD=0.80
FACE_PASSIVE_LIVENESS_MAJORITY=0.60
FACE_MIN_BLUR_VARIANCE=55
FACE_MIN_BRIGHTNESS=45
FACE_MAX_BRIGHTNESS=215
FACE_MIN_FACE_RATIO=0.12
FACE_MAX_FACE_RATIO=0.78
FACE_ACTIVE_MOTION_THRESHOLD=0.025
FACE_CROSS_FRAME_MATCH_THRESHOLD=0.50
FACE_PURGE_INTERVAL_SECONDS=3600
FACE_WORKERS=1
FACE_FORWARDED_ALLOW_IPS=127.0.0.1
PORT=8080

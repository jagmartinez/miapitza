  principalOnly Boolean                     @default(true)
  createdAt     DateTime                    @default(now())

  company      Company             @relation(fields: [companyId], references: [id], onDelete: Restrict)
  loan         HrLoan              @relation(fields: [loanId], references: [id], onDelete: Restrict)
  installments HrLoanInstallment[]

  @@unique([loanId, version])
  @@index([companyId, loanId, status])
}

model HrLoanInstallment {
  id                 Int      @id @default(autoincrement())
  companyId          Int
  scheduleVersionId  Int
  number             Int
  dueDate            DateTime @db.Date
  scheduledPrincipal Decimal  @db.Decimal(18, 2)
  scheduledCharge    Decimal  @default(0) @db.Decimal(18, 2)
  scheduledTotal     Decimal  @db.Decimal(18, 2)
  createdAt          DateTime @default(now())

  company         Company               @relation(fields: [companyId], references: [id], onDelete: Restrict)
  scheduleVersion HrLoanScheduleVersion @relation(fields: [scheduleVersionId], references: [id], onDelete: Restrict)

  @@unique([scheduleVersionId, number])
  @@index([companyId, scheduleVersionId, dueDate])
}

model HrLoanLedgerEntry {
  id              Int              @id @default(autoincrement())
  companyId       Int
  loanId          Int
  type            HrLoanLedgerType
  amount          Decimal          @db.Decimal(18, 2)
  currency        String           @db.VarChar(3)
  effectiveDate   DateTime         @db.Date
  payrollRunId    Int?
  reference       String?          @db.VarChar(160)
  reason          String           @db.Text
  actorId         Int
  reversedEntryId Int?
  createdAt       DateTime         @default(now())

  company         Company             @relation(fields: [companyId], references: [id], onDelete: Restrict)
  loan            HrLoan              @relation(fields: [loanId], references: [id], onDelete: Restrict)
  actor           User                @relation("HrLoanLedgerActor", fields: [actorId], references: [id], onDelete: Restrict)
  payrollRun      PayrollRun?         @relation(fields: [payrollRunId], references: [id], onDelete: Restrict)
  reversedEntry   HrLoanLedgerEntry?  @relation("HrLoanLedgerReversal", fields: [reversedEntryId], references: [id], onDelete: Restrict)
  reversalEntries HrLoanLedgerEntry[] @relation("HrLoanLedgerReversal")

  @@unique([reversedEntryId])
  @@unique([loanId, type, reference])
  @@index([companyId, loanId, createdAt])
  @@index([payrollRunId])
}

enum HrDeductionStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
  REVERSED
}

enum HrDeductionFrequency {
  ONCE
  RECURRING
}

enum HrDeductionSource {
  MANUAL
  LOAN
  LEGAL
}

enum HrDeductionApplicationKind {
  APPLIED
  REVERSAL
}

model HrDeduction {
  id                       Int               @id @default(autoincrement())
  companyId                Int
  code                     String            @db.VarChar(64)
  userId                   Int
  employeeId               Int
  loanId                   Int?              @unique
  source                   HrDeductionSource @default(MANUAL)
  status                   HrDeductionStatus @default(DRAFT)
  revision                 Int               @default(0)
  remainingAmount          Decimal?          @db.Decimal(18, 2)
  lastPayrollApplicationId String?           @db.VarChar(160)
  createdById              Int
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt

  company      Company                  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  user         User                     @relation("HrDeductionSubject", fields: [userId], references: [id], onDelete: Restrict)
  employee     Employee                 @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  loan         HrLoan?                  @relation(fields: [loanId], references: [id], onDelete: Restrict)
  createdBy    User                     @relation("HrDeductionCreator", fields: [createdById], references: [id], onDelete: Restrict)
  versions     HrDeductionVersion[]
  applications HrDeductionApplication[]

  @@unique([companyId, code])
  @@index([companyId, userId, status, createdAt])
}

model HrDeductionVersion {
  id               Int                  @id @default(autoincrement())
  companyId        Int
  deductionId      Int
  version          Int
  name             String               @db.VarChar(120)
  reason           String               @db.Text
  currency         String               @db.VarChar(3)
  frequency        HrDeductionFrequency
  requestedAmount  Decimal              @db.Decimal(18, 2)
  applicableAmount Decimal              @db.Decimal(18, 2)
  perPeriodLimit   Decimal?             @db.Decimal(18, 2)
  priority         Int
  effectiveFrom    DateTime             @db.Date
  effectiveTo      DateTime?            @db.Date
  createdAt        DateTime             @default(now())

  company      Company                  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  deduction    HrDeduction              @relation(fields: [deductionId], references: [id], onDelete: Restrict)
  applications HrDeductionApplication[]

  @@unique([deductionId, version])
  @@index([companyId, deductionId, createdAt])
}

model HrDeductionApplication {
  id           Int                        @id @default(autoincrement())
  companyId    Int
  deductionId  Int
  versionId    Int
  payrollRunId Int
  kind         HrDeductionApplicationKind @default(APPLIED)
  amount       Decimal                    @db.Decimal(18, 2)
  currency     String                     @db.VarChar(3)
  componentId  Int?
  reason       String                     @db.Text
  actorId      Int
  reversalOfId Int?
  createdAt    DateTime                   @default(now())

  company    Company                  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  deduction  HrDeduction              @relation(fields: [deductionId], references: [id], onDelete: Restrict)
  version    HrDeductionVersion       @relation(fields: [versionId], references: [id], onDelete: Restrict)
  payrollRun PayrollRun               @relation(fields: [payrollRunId], references: [id], onDelete: Restrict)
  actor      User                     @relation("HrDeductionApplicationActor", fields: [actorId], references: [id], onDelete: Restrict)
  reversalOf HrDeductionApplication?  @relation("HrDeductionApplicationReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversals  HrDeductionApplication[] @relation("HrDeductionApplicationReversal")

  @@unique([deductionId, payrollRunId, kind])
  @@unique([reversalOfId])
  @@index([companyId, payrollRunId, createdAt])
}

model HrBenefitTrace {
  id           Int      @id @default(autoincrement())
  companyId    Int
  resourceType String   @db.VarChar(32)
  resourceId   Int
  event        String   @db.VarChar(64)
  actorId      Int?
  reason       String?  @db.Text
  fromStatus   String?  @db.VarChar(32)
  toStatus     String?  @db.VarChar(32)
  revision     Int
  metadata     Json?
  occurredAt   DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  actor   User?   @relation("HrBenefitTraceActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([companyId, resourceType, resourceId, occurredAt])
}

model HrBenefitIdempotencyRecord {
  id          Int      @id @default(autoincrement())
  companyId   Int
  key         String   @db.VarChar(128)
  operation   String   @db.VarChar(100)
  requestHash String   @db.VarChar(64)
  response    Json?
  createdAt   DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, key])
  @@index([companyId, operation, createdAt])
}

enum HrBenefitPolicyStatus {
  DRAFT
  ACTIVE
  RETIRED
}

model HrBenefitPolicyVersion {
  id                     Int                   @id @default(autoincrement())
  companyId              Int
  version                Int
  status                 HrBenefitPolicyStatus @default(DRAFT)
  effectiveFrom          DateTime              @db.Date
  effectiveTo            DateTime?             @db.Date
  currency               String                @db.VarChar(3)
  travelCategories       Json
  travelMaxDays          Int
  travelEvidenceRequired Boolean               @default(true)
  loanMinTenureMonths    Int
  loanMaxAmount          Decimal               @db.Decimal(18, 2)
  loanMaxInstallments    Int
  loanMaxPaymentPercent  Decimal               @db.Decimal(5, 2)
  sourceReference        String                @db.VarChar(300)
  reason                 String                @db.Text
  createdById            Int
  activatedById          Int?
  activatedAt            DateTime?
  revision               Int                   @default(0)
  createdAt              DateTime              @default(now())

  company        Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  createdBy      User              @relation("HrBenefitPolicyCreator", fields: [createdById], references: [id], onDelete: Restrict)
  activatedBy    User?             @relation("HrBenefitPolicyActivator", fields: [activatedById], references: [id], onDelete: Restrict)
  travelRequests HrTravelRequest[]
  loans          HrLoan[]

  @@unique([companyId, version])
  @@index([companyId, status, effectiveFrom])
}

enum HrEmploymentSettlementStatus {
  DRAFT
  SUBMITTED
  REVIEWED
  APPROVED
  REJECTED
  PAID
  VOID
}

enum HrEmploymentExitType {
  RESIGNATION
  DISMISSAL
  MUTUAL_AGREEMENT
  CONTRACT_END
  OTHER
}

enum HrEmploymentSettlementLineType {
  EARNED_SALARY
  VACATION
  AGUINALDO
  INDEMNITY
  OTHER_EARNING
  DEDUCTION
}

model HrEmploymentSettlement {
  id                 Int                          @id @default(autoincrement())
  companyId          Int
  code               String                       @db.VarChar(64)
  employeeId         Int
  userId             Int
  exitType           HrEmploymentExitType
  cause              String                       @db.VarChar(300)
  justification      String                       @db.Text
  terminationDate    DateTime                     @db.Date
  currency           String                       @db.VarChar(3)
  evidenceReferences Json
  grossEarnings      Decimal                      @db.Decimal(18, 2)
  totalDeductions    Decimal                      @db.Decimal(18, 2)
  netPay             Decimal                      @db.Decimal(18, 2)
  calculationHash    String                       @db.Char(64)
  status             HrEmploymentSettlementStatus @default(DRAFT)
  revision           Int                          @default(0)
  createdById        Int
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt

  company   Company                      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  employee  Employee                     @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  user      User                         @relation("HrEmploymentSettlementSubject", fields: [userId], references: [id], onDelete: Restrict)
  createdBy User                         @relation("HrEmploymentSettlementCreator", fields: [createdById], references: [id], onDelete: Restrict)
  lines     HrEmploymentSettlementLine[]

  @@unique([companyId, code])
  @@index([companyId, status, terminationDate])
  @@index([companyId, employeeId, terminationDate])
}

model HrEmploymentSettlementLine {
  id              Int                            @id @default(autoincrement())
  companyId       Int
  settlementId    Int
  type            HrEmploymentSettlementLineType
  concept         String                         @db.VarChar(160)
  formulaBasis    String                         @db.VarChar(600)
  sourceReference String                         @db.VarChar(300)
  amount          Decimal                        @db.Decimal(18, 2)
  createdAt       DateTime                       @default(now())

  company    Company                @relation(fields: [companyId], references: [id], onDelete: Restrict)
  settlement HrEmploymentSettlement @relation(fields: [settlementId], references: [id], onDelete: Restrict)

  @@index([companyId, settlementId, type])
}

// ==========================================
// 2. CONTROL DE MESAS
// ==========================================

model Table {
  id              Int         @id @default(autoincrement())
  companyId       Int
  branchId        Int
  number          String
  capacity        Int
  status          TableStatus @default(AVAILABLE)
  location        String? // Salon, Terraza, VIP
  floorAreaId     Int?
  mapX            Int         @default(0)
  mapY            Int         @default(0)
  mapWidth        Int         @default(120)
  mapHeight       Int         @default(80)
  mapShape        TableShape  @default(RECTANGLE)
  mapRotation     Int         @default(0)
  mapVersion      Int         @default(0)
  layoutUpdatedAt DateTime    @default(now()) @updatedAt

  company      Company       @relation(fields: [companyId], references: [id])
  branch       Branch        @relation(fields: [branchId], references: [id])
  floorArea    FloorArea?    @relation(fields: [floorAreaId], references: [id], onDelete: SetNull)
  orders       Order[]
  reservations Reservation[]

  @@unique([branchId, number])
  @@index([companyId])
  @@index([branchId])
  @@index([floorAreaId])
}

model FloorArea {
  id          Int            @id @default(autoincrement())
  floorPlanId Int
  companyId   Int
  branchId    Int
  name        String         @db.VarChar(100)
  kind        FloorAreaKind  @default(DINING)
  mapX        Int            @default(24)
  mapY        Int            @default(24)
  mapWidth    Int            @default(720)
  mapHeight   Int            @default(480)
  mapShape    FloorAreaShape @default(RECTANGLE)
  mapRotation Int            @default(0)
  color       String?        @db.VarChar(16)
  mapVersion  Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  company   Company        @relation(fields: [companyId], references: [id])
  branch    Branch         @relation(fields: [branchId], references: [id])
  floorPlan TableFloorPlan @relation(fields: [floorPlanId], references: [id], onDelete: Cascade)
  tables    Table[]

  @@unique([floorPlanId, name])
  @@index([floorPlanId])
  @@index([companyId])
  @@index([branchId])
}

model TableFloorPlan {
  id           Int      @id @default(autoincrement())
  companyId    Int
  branchId     Int      @unique
  canvasWidth  Int      @default(1600)
  canvasHeight Int      @default(1000)
  version      Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company Company     @relation(fields: [companyId], references: [id])
  branch  Branch      @relation(fields: [branchId], references: [id])
  areas   FloorArea[]

  @@index([companyId])
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  OUT_OF_SERVICE
}

enum TableShape {
  RECTANGLE
  SQUARE
  ROUND
}

enum FloorAreaKind {
  DINING
  TERRACE
  BAR
  PRIVATE
  TAKEAWAY
  OTHER
}

enum FloorAreaShape {
  RECTANGLE
  ROUNDED
  OVAL
  L_SHAPE
}

// ==========================================
// 3. RESERVACIONES
// ==========================================

model Reservation {
  id           Int               @id @default(autoincrement())
  companyId    Int
  branchId     Int
  tableId      Int?
  customerName String
  phone        String?
  email        String?
  date         DateTime
  peopleCount  Int
  status       ReservationStatus @default(PENDING)
  notes        String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  company Company @relation(fields: [companyId], references: [id])
  branch  Branch  @relation(fields: [branchId], references: [id])
  table   Table?  @relation(fields: [tableId], references: [id], onDelete: SetNull)
  order   Order?

  @@index([companyId])
  @@index([branchId])
  @@index([tableId])
  @@index([date])
  @@index([status])
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  CANCELLED
  NO_SHOW
  COMPLETED
}

// ==========================================
// 4. MENÚ, RECETAS E INSUMOS
// ==========================================

model Category {
  id              Int     @id @default(autoincrement())
  companyId       Int
  name            String
  description     String?
  codePrefix      String? // e.g. CAR, BEB, LAC - used for auto-generating product SKU
  sortOrder       Int     @default(0)
  active          Boolean @default(true)
  showInMenu      Boolean @default(true)
  showInInventory Boolean @default(true)

  company   Company    @relation(fields: [companyId], references: [id])
  menuItems MenuItem[]
  products  Product[] // Categories for inventory products too

  @@unique([companyId, name])
  @@unique([companyId, codePrefix])
}

// A "marca" / brand groups menu items belonging to the same business line
// served from a single physical location (e.g. two product lines under one RUC).
model MenuBrand {
  id        Int      @id @default(autoincrement())
  companyId Int
  name      String
  color     String? // accent color for the POS brand switcher (hex)
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company   Company    @relation(fields: [companyId], references: [id])
  menuItems MenuItem[]

  @@unique([companyId, name])
  @@index([companyId])
}

model MenuItem {
  id          Int          @id @default(autoincrement())
  companyId   Int
  branchId    Int? // Optional: null means global menu item (for the company)
  brandId     Int? // Optional: null means item is shared across all brands ("común")
  categoryId  Int
  name        String
  description String?
  price       Decimal      @db.Decimal(10, 2)
  active      Boolean      @default(true)
  type        MenuItemType @default(PREPARED) // Prepared (kitchen) or Direct (bottle of wine)

  // Availability by time
  availableFrom String? // Time format "HH:mm" e.g. "06:00"
  availableTo   String? // Time format "HH:mm" e.g. "11:00"
  menuType      MenuTimeType? // Breakfast, Lunch, Dinner, All Day

  company  Company    @relation(fields: [companyId], references: [id])
  category Category   @relation(fields: [categoryId], references: [id])
  branch   Branch?    @relation(fields: [branchId], references: [id])
  brand    MenuBrand? @relation(fields: [brandId], references: [id])

  recipes           Recipe[]
  images            MenuItemImage[]
  orderItems        OrderItem[]
  modifierGroups    ModifierGroup[]
  branchPrices      MenuItemBranchPrice[]
  cateringMenuItems CateringMenuItem[]
  pedidosYaMappings PedidosYaProductMapping[]

  @@index([companyId, categoryId])
  @@index([branchId])
  @@index([brandId])
}

enum MenuTimeType {
  BREAKFAST
  LUNCH
  DINNER
  ALL_DAY
}

enum MenuItemType {
  PREPARED // Uses a recipe
  DIRECT // Direct sale of a product (e.g., Can of Soda)
}

// Branch-level menu availability and pricing
model MenuItemBranchPrice {
  id         Int      @id @default(autoincrement())
  menuItemId Int
  branchId   Int
  price      Decimal  @db.Decimal(10, 2)
  active     Boolean  @default(true) // Controls availability per branch
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  branch   Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([menuItemId, branchId])
  @@index([menuItemId])
  @@index([branchId])
}

// ==========================================
// 4a. UNIDADES DE MEDIDA Y CONVERSIONES
// ==========================================

enum MeasurementType {
  MASS
  VOLUME
  UNIT
  PACKAGE
}

model UnitOfMeasure {
  id              Int             @id @default(autoincrement())
  companyId       Int
  name            String
  abbreviation    String
  measurementType MeasurementType
  systemFactor    Decimal         @db.Decimal(18, 6)
  active          Boolean         @default(true)

  company                        Company                     @relation(fields: [companyId], references: [id])
  productUnits                   ProductUnit[]
  productBase                    Product[]                   @relation("ProductBaseUnit")
  recipeUnits                    Recipe[]                    @relation("RecipeUnit")
  modifierUnits                  Modifier[]                  @relation("ModifierUnit")
  productionRecipeYields         ProductionRecipe[]          @relation("ProductionRecipeYieldUnit")
  productionRecipeComponentUnits ProductionRecipeComponent[] @relation("ProductionRecipeComponentUnit")
  productionOrderItemUnits       ProductionOrderItem[]       @relation("ProductionOrderItemUnit")

  @@unique([companyId, abbreviation])
  @@index([companyId])
}

model ProductUnit {
  id               Int     @id @default(autoincrement())
  companyId        Int
  productId        Int
  unitId           Int
  conversionFactor Decimal @db.Decimal(18, 6)
  isDefault        Boolean @default(false)
  active           Boolean @default(true)

  company Company       @relation(fields: [companyId], references: [id])
  product Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  unit    UnitOfMeasure @relation(fields: [unitId], references: [id])

  @@unique([productId, unitId])
  @@index([companyId])
  @@index([productId])
}

// Ingredients and Direct Sale Products
model Product {
  id                    Int          @id @default(autoincrement())
  companyId             Int
  name                  String
  sku                   String?
  categoryId            Int?
  unit                  String // Legacy: kg, g, L, ml, unit
  baseUnitId            Int?
  minStock              Decimal      @default(0) @db.Decimal(10, 3)
  cost                  Decimal      @default(0) @db.Decimal(10, 2)
  // A zero can be a reviewed cost (donation/sample) or a legacy missing value.
  // These flags make that distinction explicit without changing legacy numbers.
  referenceCostKnown    Boolean      @default(false)
  currentAverageCost    Decimal      @default(0) @db.Decimal(10, 6)
  averageCostKnown      Boolean      @default(false)
  lastPurchaseCost      Decimal      @default(0) @db.Decimal(10, 6)
  lastPurchaseCostKnown Boolean      @default(false)
  price                 Decimal?     @db.Decimal(10, 2)
  type                  ProductType  @default(INGREDIENT)
  storageType           StorageType?
  observation           String?      @db.Text
  active                Boolean      @default(true)
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  company  Company        @relation(fields: [companyId], references: [id])
  category Category?      @relation(fields: [categoryId], references: [id])
  baseUnit UnitOfMeasure? @relation("ProductBaseUnit", fields: [baseUnitId], references: [id])

  stocks               Stock[]
  inventoryMovements   InventoryMovement[]
  inventoryBatches     InventoryBatch[]
  purchaseOrderItems   PurchaseOrderItem[]
  recipes              Recipe[]
  costHistory          ProductCostHistory[]
  allowedUnits         ProductUnit[]
  modifierLinks        Modifier[]                  @relation("ModifierProduct")
  productionRecipes    ProductionRecipe[]          @relation("ProductProductionRecipes")
  recipeComponents     ProductionRecipeComponent[] @relation("ProductRecipeComponents")
  productionOrders     ProductionOrder[]           @relation("ProductProductionOrders")
  productionOrderItems ProductionOrderItem[]       @relation("ProductProductionOrderItems")

  @@unique([companyId, sku])
  @@index([categoryId])
  @@index([companyId])
  @@index([companyId, active])
}

enum ProductType {
  INGREDIENT // Materia prima / insumo comprado
  PRODUCT_FOR_SALE // Producto terminado para la venta
  BOTH // Insumo y producto de venta (venta directa)
  INTERMEDIATE // Producto intermedio / semielaborado producido internamente
  PACKAGING // Empaque / material de empaque
}

enum StorageType {
  PERISHABLE
  FROZEN
  NON_PERISHABLE
}

model Recipe {
  id         Int     @id @default(autoincrement())
  menuItemId Int
  productId  Int
  quantity   Decimal @db.Decimal(10, 3)
  unit       String?
  unitId     Int?

  menuItem      MenuItem       @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  product       Product        @relation(fields: [productId], references: [id])
  unitOfMeasure UnitOfMeasure? @relation("RecipeUnit", fields: [unitId], references: [id])

  @@unique([menuItemId, productId])
  @@index([menuItemId])
  @@index([productId])
}

model MenuItemImage {
  id         Int      @id @default(autoincrement())
  menuItemId Int
  imageUrl   String   @db.LongText
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
}

// ==========================================
// 5. INVENTARIO Y ALMACENES
// ==========================================

model Warehouse {
  id        Int           @id @default(autoincrement())
  companyId Int
  branchId  Int?
  type      WarehouseType @default(BRANCH)
  name      String // Main, Kitchen, Bar
  code      String

  company                    Company                     @relation(fields: [companyId], references: [id])
  branch                     Branch?                     @relation(fields: [branchId], references: [id])
  stocks                     Stock[]
  movements                  InventoryMovement[]
  inventoryBatches           InventoryBatch[]
  pedidosYaConfigs           PedidosYaConfig[]
  ProductionOrder            ProductionOrder[]
  fiscalCreditNotes          FiscalCreditNote[]
  fiscalInvoiceCancellations FiscalInvoiceCancellation[]

  @@unique([companyId, code])
  @@unique([companyId, branchId, name])
  @@index([companyId])
  @@index([branchId])
}

enum WarehouseType {
  CENTRAL
  BRANCH
}

model Stock {
  id          Int     @id @default(autoincrement())
  warehouseId Int
  productId   Int
  companyId   Int
  quantity    Decimal @default(0) @db.Decimal(18, 6)

  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  product   Product   @relation(fields: [productId], references: [id])
  company   Company   @relation(fields: [companyId], references: [id])

  @@unique([warehouseId, productId])
  @@index([companyId])
  @@index([warehouseId])
}

model InventoryMovement {
  id               Int          @id @default(autoincrement())
  warehouseId      Int
  productId        Int
  userId           Int
  companyId        Int
  type             MovementType
  transferGroupId  String?
  direction        String?      @db.VarChar(3)
  origin           String?      @db.VarChar(32)
  quantity         Decimal      @db.Decimal(18, 6)
  reason           String?
  reference        String?
  originalQuantity Decimal?     @db.Decimal(18, 6)
  originalUnit     String?
  conversionFactor Decimal?     @db.Decimal(18, 6)
  unitCost         Decimal?     @db.Decimal(18, 6)
  totalCost        Decimal?     @db.Decimal(18, 6)
  balanceQty       Decimal?     @db.Decimal(18, 6)
  balanceCost      Decimal?     @db.Decimal(18, 6)
  // Exact FIFO portions consumed by an OUT movement. This lets a compensating
  // reversal recreate the original layers/cost order instead of one averaged lot.
  consumedLayers   Json?
  reversalOfId     Int?
  reversalGroupId  String?      @db.VarChar(191)
  reversalKey      String?      @db.VarChar(191)
  createdAt        DateTime     @default(now())

  warehouse           Warehouse           @relation(fields: [warehouseId], references: [id])
  product             Product             @relation(fields: [productId], references: [id])
  user                User                @relation(fields: [userId], references: [id])
  company             Company             @relation(fields: [companyId], references: [id])
  reversalOf          InventoryMovement?  @relation("InventoryMovementReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversal            InventoryMovement?  @relation("InventoryMovementReversal")
  openedBatches       InventoryBatch[]    @relation("InventoryMovementBatches")
  costHistory         ProductCostHistory? @relation("InventoryMovementCostHistory")
  reversedCostHistory ProductCostHistory? @relation("InventoryMovementCostHistoryReversal")

  @@unique([reversalOfId], map: "InvMove_reversalOf_key")
  @@index([productId])
  @@index([warehouseId])
  @@index([createdAt])
  @@index([companyId, productId, createdAt])
  @@index([transferGroupId])
  @@index([companyId, reversalKey], map: "InvMove_company_reversalKey_idx")
  @@index([reversalGroupId], map: "InvMove_reversalGroup_idx")
}

enum MovementType {
  IN
  OUT
  ADJUSTMENT
  TRANSFER
}

// FIFO cost layers per (warehouse, product). Each inbound movement opens a batch
// with its own unit cost; outbound movements consume batches oldest-first to
// derive a real FIFO cost of goods. Only relevant when Company.costingMethod = FIFO;
// for WEIGHTED_AVERAGE these rows are still maintained but not used for valuation.
model InventoryBatch {
  id               Int      @id @default(autoincrement())
  companyId        Int
  warehouseId      Int
  productId        Int
  unitCost         Decimal  @db.Decimal(18, 6)
  originalQty      Decimal  @db.Decimal(18, 6)
  remainingQty     Decimal  @db.Decimal(18, 6)
  sourceType       String // PURCHASE | PRODUCTION | ADJUSTMENT | TRANSFER | OPENING
  sourceRef        String?
  sourceMovementId Int?
  createdAt        DateTime @default(now())

  company        Company            @relation(fields: [companyId], references: [id])
  warehouse      Warehouse          @relation(fields: [warehouseId], references: [id])
  product        Product            @relation(fields: [productId], references: [id])
  sourceMovement InventoryMovement? @relation("InventoryMovementBatches", fields: [sourceMovementId], references: [id], onDelete: Restrict)

  @@index([companyId, productId, warehouseId, createdAt])
  @@index([warehouseId, productId])
  @@index([remainingQty])
  @@index([sourceMovementId], map: "InvBatch_sourceMovement_idx")
}

// ==========================================
// 6. COMPRAS Y PROVEEDORES
// ==========================================

model Supplier {
  id         Int     @id @default(autoincrement())
  companyId  Int
  name       String
  contact    String?
  phone      String?
  email      String?
  address    String?
  taxId      String? // RUC/NIT
  supplyType String? // e.g., "Vegetables", "Meats", "Services"
  active     Boolean @default(true)

  company        Company         @relation(fields: [companyId], references: [id])
  purchaseOrders PurchaseOrder[]
  cashMovements  CashMovement[]

  @@index([companyId])
}

model PurchaseOrder {
  id             Int                 @id @default(autoincrement())
  companyId      Int
  branchId       Int
  supplierId     Int
  date           DateTime            @default(now())
  status         PurchaseOrderStatus @default(DRAFT)
  total          Decimal             @default(0) @db.Decimal(10, 2)
  notes          String?
  invoiceNumber  String?
  invoicePdf     String?
  invoiceDate    DateTime?
  invoiceType    InvoiceType         @default(CASH)
  paymentDueDate DateTime?
  bank           String?
  transferNumber String?
  paidAmount     Decimal             @default(0) @db.Decimal(10, 2)
  paymentStatus  PaymentStatus       @default(PENDING)

  company  Company                @relation(fields: [companyId], references: [id])
  branch   Branch                 @relation(fields: [branchId], references: [id])
  supplier Supplier               @relation(fields: [supplierId], references: [id])
  items    PurchaseOrderItem[]
  payments PurchaseOrderPayment[]

  @@index([supplierId])
  @@index([status])
  @@index([companyId])
  @@index([companyId, branchId])
}

enum InvoiceType {
  CASH
  CREDIT
}

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
}

enum PurchaseOrderStatus {
  DRAFT
  ISSUED
  RECEIVED
  CANCELLED
}

model PurchaseOrderPayment {
  id              Int                @id @default(autoincrement())
  purchaseOrderId Int
  amount          Decimal            @db.Decimal(10, 2)
  date            DateTime           @default(now())
  bank            String?
  referenceNumber String?
  observations    String?            @db.Text
  createdAt       DateTime           @default(now())
  status          SalesPaymentStatus @default(ACTIVE)
  reversedAt      DateTime?
  reversedById    Int?
  reversalReason  String?

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  reversedBy    User?         @relation("PurchaseOrderPaymentReversedBy", fields: [reversedById], references: [id])

  @@index([purchaseOrderId])
  @@index([status])
  @@index([reversedById])
}

model PurchaseOrderItem {
  id               Int      @id @default(autoincrement())
  purchaseOrderId  Int
  productId        Int
  quantity         Decimal  @db.Decimal(18, 6)
  cost             Decimal  @db.Decimal(18, 6)
  subtotal         Decimal  @db.Decimal(18, 6)
  purchaseUnit     String?
  conversionFactor Decimal? @db.Decimal(18, 6)
  baseQuantity     Decimal? @db.Decimal(18, 6)
  baseCost         Decimal? @db.Decimal(18, 6)

  purchaseOrder PurchaseOrder        @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product       Product              @relation(fields: [productId], references: [id])
  costHistory   ProductCostHistory[]

  @@index([purchaseOrderId])
  @@index([productId])
}

// Product Cost History - Tracks cost changes for auditing
model ProductCostHistory {
  id                   Int       @id @default(autoincrement())
  productId            Int
  companyId            Int
  purchaseOrderItemId  Int?
  productionOrderId    Int?
  inventoryMovementId  Int?
  reversalMovementId   Int?
  quantity             Decimal   @db.Decimal(18, 6)
  unitCost             Decimal   @db.Decimal(18, 6)
  previousAvgCost      Decimal   @db.Decimal(18, 6)
  previousAvgCostKnown Boolean   @default(false)
  newAvgCost           Decimal   @db.Decimal(18, 6)
  newAvgCostKnown      Boolean   @default(true)
  previousStock        Decimal   @db.Decimal(18, 6)
  newStock             Decimal   @db.Decimal(18, 6)
  reversedAt           DateTime?
  createdAt            DateTime  @default(now())

  product           Product            @relation(fields: [productId], references: [id])
  purchaseOrderItem PurchaseOrderItem? @relation(fields: [purchaseOrderItemId], references: [id])
  productionOrder   ProductionOrder?   @relation(fields: [productionOrderId], references: [id])
  inventoryMovement InventoryMovement? @relation("InventoryMovementCostHistory", fields: [inventoryMovementId], references: [id], onDelete: Restrict)
  reversalMovement  InventoryMovement? @relation("InventoryMovementCostHistoryReversal", fields: [reversalMovementId], references: [id], onDelete: Restrict)
  company           Company            @relation(fields: [companyId], references: [id])

  @@unique([inventoryMovementId], map: "ProdCostHist_inventoryMove_key")
  @@unique([reversalMovementId], map: "ProdCostHist_reversalMove_key")
  @@index([productId])
  @@index([companyId])
  @@index([productionOrderId])
  @@index([createdAt])
}

// ==========================================
// 7. POS Y VENTAS
// ==========================================

model Order {
  id                      Int                  @id @default(autoincrement())
  companyId               Int
  branchId                Int
  tableId                 Int?
  reservationId           Int?                 @unique
  userId                  Int // Waiter/Cashier who created the order
  cashRegisterId          Int? // Linked when paid/processed
  cashRegister            CashRegister?        @relation("OrderCashRegister", fields: [cashRegisterId], references: [id])
  customerName            String?
  customerTaxId           String?              @db.VarChar(100)
  customerTaxIdType       String?              @db.VarChar(50)
  customerFiscalAddress   String?              @db.Text
  customerEmail           String?              @db.VarChar(191)
  customerPhone           String?              @db.VarChar(50)
  orderType               OrderType            @default(DINE_IN)
  salesChannel            SalesChannel         @default(RESTAURANT)
  status                  OrderStatus          @default(OPEN)
  financialStatus         OrderFinancialStatus @default(UNPAID)
  total                   Decimal              @default(0) @db.Decimal(10, 2)
  discount                Decimal              @default(0) @db.Decimal(10, 2)
  discountCode            String? // Applied promotion/discount code
  tipAmount               Decimal              @default(0) @db.Decimal(10, 2)
  tax                     Decimal              @default(0) @db.Decimal(10, 2)
  channelCommission       Decimal              @default(0) @db.Decimal(10, 2) // e.g. 24% PedidosYa commission
  channelMarkup           Decimal              @default(0) @db.Decimal(10, 2) // price markup applied for channel
  invoiceNumber           String?              @unique
  invoicedAt              DateTime?
  invoiceFiscalStatus     InvoiceFiscalStatus  @default(NOT_ISSUED)
  // Immutable fiscal rendering payload captured when the number is issued.
  // Reads and PDF downloads must never reconstruct an issued document from
  // mutable menu, company, branch or settings master data.
  invoiceSnapshot         Json?
  cancelledById           Int? // User who cancelled the order
  cancelReason            String? // Reason for cancellation
  cancelledAt             DateTime? // Timestamp of cancellation
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt
  closedAt                DateTime?
  deliveredAt             DateTime?
  kitchenStartedAt        DateTime?
  kitchenStartedById      Int?
  kitchenReleasedAt       DateTime?
  kitchenReleasedById     Int?
  // Set when an unpaid order is absorbed into another order during an atomic
  // table-account consolidation. Kept scalar intentionally: cancelled source
  // orders remain immutable audit records without a cascading self relation.
  consolidatedIntoOrderId Int?

  company           Company      @relation(fields: [companyId], references: [id])
  branch            Branch       @relation(fields: [branchId], references: [id])
  table             Table?       @relation(fields: [tableId], references: [id])
  reservation       Reservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  user              User         @relation("OrderCreator", fields: [userId], references: [id])
  cancelledBy       User?        @relation("OrderCancelledBy", fields: [cancelledById], references: [id])
  kitchenStartedBy  User?        @relation("OrderKitchenStartedBy", fields: [kitchenStartedById], references: [id], onDelete: SetNull)
  kitchenReleasedBy User?        @relation("OrderKitchenReleasedBy", fields: [kitchenReleasedById], references: [id], onDelete: SetNull)

  items                     OrderItem[]
  payments                  Payment[]
  pedidosYaSyncs            PedidosYaOrderSync[]
  kitchenNotifications      KitchenNotification[]
  fiscalCreditNotes         FiscalCreditNote[]
  fiscalInvoiceCancellation FiscalInvoiceCancellation?

  @@index([companyId, branchId])
  @@index([companyId, status])
  @@index([companyId, financialStatus, closedAt])
  @@index([companyId, invoicedAt])
  @@index([companyId, createdAt])
  @@index([userId])
  @@index([tableId])
  @@index([companyId, kitchenReleasedAt, status])
  @@index([kitchenStartedById])
  @@index([kitchenReleasedById])
}

enum OrderType {
  DINE_IN
  TAKEOUT
  DELIVERY
}

enum SalesChannel {
  RESTAURANT
  DELIVERY
  PEDIDOSYA
}

enum OrderStatus {
  OPEN
  SENT_TO_KITCHEN
  IN_PREPARATION
  READY
  CANCELLED
  DELIVERED
}

enum OrderFinancialStatus {
  UNPAID
  PARTIAL
  PAID
}

model OrderItem {
  id            Int             @id @default(autoincrement())
  orderId       Int
  menuItemId    Int
  quantity      Int
  price         Decimal         @db.Decimal(10, 2)
  subtotal      Decimal         @db.Decimal(10, 2)
  notes         String?
  status        OrderItemStatus @default(PENDING)
  sentAt        DateTime? // When sent to kitchen
  startedAt     DateTime? // When kitchen started preparing
  finishedAt    DateTime? // When kitchen finished preparing
  // Durable provenance for table transfers/consolidations. The first origin is
  // retained even if an item is moved more than once.
  originOrderId Int?
  originTableId Int?

  order                 Order                  @relation(fields: [orderId], references: [id], onDelete: Restrict)
  menuItem              MenuItem               @relation(fields: [menuItemId], references: [id])
  modifiers             OrderItemModifier[]
  fiscalCreditNoteLines FiscalCreditNoteLine[]

  @@index([orderId])
  @@index([menuItemId])
  @@index([originOrderId])
  @@index([originTableId])
}

enum OrderItemStatus {
  PENDING
  IN_PROGRESS
  DONE
}

enum KitchenNotificationEventType {
  ORDER_ITEM_READY
  ORDER_READY
  ORDER_RELEASED
}

enum KitchenNotificationStatus {
  UNREAD
  SEEN
  ATTENDED
}

model KitchenNotification {
  id          Int                          @id @default(autoincrement())
  companyId   Int
  branchId    Int
  orderId     Int
  userId      Int
  eventType   KitchenNotificationEventType
  dedupKey    String                       @db.VarChar(191)
  status      KitchenNotificationStatus    @default(UNREAD)
  tableNumber String?                      @db.VarChar(20)
  message     String                       @db.VarChar(500)
  payload     Json?
  seenAt      DateTime?
  attendedAt  DateTime?
  createdAt   DateTime                     @default(now())
  updatedAt   DateTime                     @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  branch  Branch  @relation(fields: [branchId], references: [id], onDelete: Restrict)
  order   Order   @relation(fields: [orderId], references: [id], onDelete: Restrict)
  user    User    @relation("KitchenNotificationRecipient", fields: [userId], references: [id], onDelete: Restrict)

  @@unique([companyId, dedupKey])
  @@index([companyId, branchId, createdAt])
  @@index([userId, status, createdAt])
  @@index([orderId, eventType])
}

enum PaymentMethodType {
  CASH
  CARD
  BANK_TRANSFER
  OTHER
}

model PaymentMethod {
  id        Int               @id @default(autoincrement())
  companyId Int? // Optional: null means system-wide
  name      String // Display label only; business behavior is driven by `type`.
  type      PaymentMethodType @default(OTHER)
  active    Boolean           @default(true)

  company          Company?          @relation(fields: [companyId], references: [id])
  payments         Payment[]
  cateringPayments CateringPayment[]

  @@index([companyId, type])
}

model Payment {
  id              Int                @id @default(autoincrement())
  orderId         Int
  paymentMethodId Int
  methodType      PaymentMethodType
  amount          Decimal            @db.Decimal(10, 2)
  reference       String?
  payerName       String? // Name of the person paying (for split bills)
  idempotencyKey  String?            @db.VarChar(191)
  registeredById  Int? // User (cashier) who registered the payment
  createdAt       DateTime           @default(now())
  status          SalesPaymentStatus @default(ACTIVE)
  reversedAt      DateTime?
  reversedById    Int?
  reversalReason  String?
  refundReference String?            @db.VarChar(191)

  order                   Order                           @relation(fields: [orderId], references: [id], onDelete: Restrict)
  paymentMethod           PaymentMethod                   @relation(fields: [paymentMethodId], references: [id])
  registeredBy            User?                           @relation("PaymentRegisteredBy", fields: [registeredById], references: [id], onDelete: Restrict)
  reversedBy              User?                           @relation("PaymentReversedBy", fields: [reversedById], references: [id], onDelete: Restrict)
  fiscalCreditNoteRefunds FiscalCreditNotePaymentRefund[]

  @@unique([orderId, idempotencyKey])
  @@index([orderId])
  @@index([paymentMethodId])
  @@index([methodType, createdAt])
  @@index([registeredById])
  @@index([reversedById])
  @@index([status, createdAt])
}

enum SalesPaymentStatus {
  ACTIVE
  REVERSED
}

// ==========================================
// 8. CAJA
// ==========================================

model CashRegister {
  id        Int                @id @default(autoincrement())
  companyId Int
  branchId  Int
  name      String
  status    CashRegisterStatus @default(CLOSED)

  company Company     @relation(fields: [companyId], references: [id])
  branch  Branch      @relation(fields: [branchId], references: [id])
  shifts  CashShift[]
  orders  Order[]     @relation("OrderCashRegister")

  @@index([companyId])
  @@index([branchId])
}

enum CashRegisterStatus {
  OPEN
  CLOSED
}

model CashShift {
  id             Int       @id @default(autoincrement())
  companyId      Int
  cashRegisterId Int
  userId         Int
  startDate      DateTime  @default(now())
  endDate        DateTime?
  startAmount    Decimal   @db.Decimal(10, 2)
  endAmount      Decimal?  @db.Decimal(10, 2)
  difference     Decimal?  @db.Decimal(10, 2) // Surplus/Deficit
  notes          String?

  company      Company            @relation(fields: [companyId], references: [id])
  cashRegister CashRegister       @relation(fields: [cashRegisterId], references: [id])
  user         User               @relation(fields: [userId], references: [id])
  movements    CashMovement[]
  counts       CashCount[]
  depositLinks BankDepositShift[]

  @@index([companyId, cashRegisterId])
  @@index([userId])
  @@index([cashRegisterId])
}

model BankDeposit {
  id             Int               @id @default(autoincrement())
  companyId      Int
  date           DateTime
  amount         Decimal           @db.Decimal(10, 2)
  bankAccount    String
  reference      String
  notes          String?
  status         BankDepositStatus @default(ACTIVE)
  createdById    Int
  createdAt      DateTime          @default(now())
  reversedAt     DateTime?
  reversedById   Int?
  reversalReason String?

  company    Company            @relation(fields: [companyId], references: [id])
  createdBy  User               @relation("BankDepositCreatedBy", fields: [createdById], references: [id])
  reversedBy User?              @relation("BankDepositReversedBy", fields: [reversedById], references: [id])
  shifts     BankDepositShift[]

  @@unique([companyId, reference])
  @@index([companyId, date])
  @@index([status])
}

model BankDepositShift {
  id        Int @id @default(autoincrement())
  depositId Int
  shiftId   Int

  deposit BankDeposit @relation(fields: [depositId], references: [id], onDelete: Restrict)
  shift   CashShift   @relation(fields: [shiftId], references: [id], onDelete: Restrict)

  @@unique([depositId, shiftId])
  @@index([shiftId])
  @@index([depositId])
}

enum BankDepositStatus {
  ACTIVE
  REVERSED
}

model CashCount {
  id           Int     @id @default(autoincrement())
  shiftId      Int
  type         String  @default("BILL") // "BILL", "COIN" or "USD_BILL"
  denomination Decimal @db.Decimal(10, 2)
  count        Int

  shift CashShift @relation(fields: [shiftId], references: [id], onDelete: Restrict)

  @@index([shiftId])
}

model CashMovement {
  id             Int              @id @default(autoincrement())
  shiftId        Int
  type           CashMovementType
  amount         Decimal          @db.Decimal(10, 2)
  description    String?
  reference      String? // Order ID if sale
  createdAt      DateTime         @default(now())
  documentDate   DateTime?
  documentType   DocumentType?
  documentNumber String?
  supplierId     Int?

  shift    CashShift @relation(fields: [shiftId], references: [id], onDelete: Restrict)
  supplier Supplier? @relation(fields: [supplierId], references: [id])

  @@index([shiftId])
  @@index([reference])
}

enum CashMovementType {
  IN
  OUT
}

enum DocumentType {
  FACTURA
  RECIBO_GASTO
  RECIBO_CAJA
  NOTA_CREDITO
  NOTA_DEBITO
}

// ==========================================
// 9. MODIFICADORES
// ==========================================

model ModifierGroup {
  id          Int      @id @default(autoincrement())
  companyId   Int
  name        String
  description String?
  minSelect   Int      @default(0)
  maxSelect   Int?     @default(1)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company   Company    @relation(fields: [companyId], references: [id])
  menuItems MenuItem[]
  modifiers Modifier[]

  @@index([companyId])
}

model Modifier {
  id              Int      @id @default(autoincrement())
  modifierGroupId Int
  name            String
  price           Decimal  @default(0) @db.Decimal(10, 2)
  active          Boolean  @default(true)
  // Optional inventory link: when set, selecting this modifier consumes
  // `consumeQuantity` (in `unitId`, or the product base unit) of `productId`.
  productId       Int?
  consumeQuantity Decimal? @db.Decimal(10, 3)
  unitId          Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  modifierGroup      ModifierGroup       @relation(fields: [modifierGroupId], references: [id])
  product            Product?            @relation("ModifierProduct", fields: [productId], references: [id])
  unit               UnitOfMeasure?      @relation("ModifierUnit", fields: [unitId], references: [id])
  orderItemModifiers OrderItemModifier[]

  @@index([modifierGroupId])
  @@index([productId])
  @@index([unitId])
}

model OrderItemModifier {
  id          Int     @id @default(autoincrement())
  orderItemId Int
  modifierId  Int
  name        String
  price       Decimal @db.Decimal(10, 2)

  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  modifier  Modifier  @relation(fields: [modifierId], references: [id])

  @@index([orderItemId])
  @@index([modifierId])
}

// ==========================================
// 10. PROMOCIONES Y DESCUENTOS
// ==========================================

model Promotion {
  id             Int           @id @default(autoincrement())
  companyId      Int
  code           String
  name           String
  description    String?
  type           PromotionType @default(PERCENTAGE)
  value          Decimal       @db.Decimal(10, 2) // Percentage or fixed amount
  minOrderAmount Decimal?      @db.Decimal(10, 2)
  maxDiscount    Decimal?      @db.Decimal(10, 2)
  validFrom      DateTime      @default(now())
  validTo        DateTime?
  usageLimit     Int? // Max times it can be used
  usageCount     Int           @default(0)
  active         Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, code])
}

enum PromotionType {
  PERCENTAGE
  FIXED_AMOUNT
}

// ==========================================
// 10a. SALES CHANNEL CONFIGURATION
// ==========================================

model SalesChannelConfig {
  id             Int          @id @default(autoincrement())
  companyId      Int
  channel        SalesChannel
  name           String // Display name: "PedidosYa", "Delivery Propio"
  priceMarkupPct Decimal      @default(0) @db.Decimal(5, 2) // e.g. 18.00 for 18%
  commissionPct  Decimal      @default(0) @db.Decimal(5, 2) // e.g. 24.00 for 24%
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, channel])
  @@index([companyId])
}

// ==========================================
// 11. CONFIGURACIÓN GLOBAL
// ==========================================

model Setting {
  id        Int      @id @default(autoincrement())
  companyId Int? // Global or Company specific
  name      String
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company? @relation(fields: [companyId], references: [id])

  @@unique([companyId, name])
}

// ==========================================
// 12. CATERING MODULE
// ==========================================

model CateringEvent {
  id                        Int            @id @default(autoincrement())
  companyId                 Int
  branchId                  Int
  customerId                Int?
  title                     String
  date                      DateTime
  peopleCount               Int
  status                    CateringStatus @default(QUOTED)
  totalAmount               Decimal        @default(0) @db.Decimal(10, 2)
  balance                   Decimal        @default(0) @db.Decimal(10, 2)
  /// Fiscal decomposition captured while the quote is still editable. Nullable
  /// distinguishes legacy events whose historical tax basis is unknowable.
  fiscalSubtotal            Decimal?       @db.Decimal(10, 2)
  fiscalTax                 Decimal?       @db.Decimal(10, 2)
  fiscalTaxRatePercent      Decimal?       @db.Decimal(7, 4)
  pricingSnapshotCapturedAt DateTime?
  location                  String?
  notes                     String?        @db.Text
  clauses                   Json?
  createdAt                 DateTime       @default(now())
  updatedAt                 DateTime       @updatedAt

  company          Company                   @relation(fields: [companyId], references: [id])
  branch           Branch                    @relation(fields: [branchId], references: [id])
  customer         Customer?                 @relation(fields: [customerId], references: [id])
  services         CateringServiceItem[]
  menuItems        CateringMenuItem[]
  payments         CateringPayment[]
  fiscalInvoice    CateringFiscalInvoice?
  fiscalCreditNote CateringFiscalCreditNote?

  @@index([companyId])
  @@index([branchId])
  @@index([customerId])
  @@index([date])
}

enum CateringStatus {
  QUOTED
  RESERVED
  PAID
  FINISHED
  CANCELLED
}

model CateringService {
  id           Int      @id @default(autoincrement())
  companyId    Int
  name         String
  description  String?  @db.Text
  internalCost Decimal  @default(0) @db.Decimal(10, 2)
  salePrice    Decimal  @default(0) @db.Decimal(10, 2)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company Company               @relation(fields: [companyId], references: [id])
  items   CateringServiceItem[]
}

model CateringServiceItem {
  id                Int     @id @default(autoincrement())
  cateringEventId   Int
  cateringServiceId Int
  quantity          Decimal @db.Decimal(10, 2)
  unitPrice         Decimal @db.Decimal(10, 2)
  subtotal          Decimal @db.Decimal(10, 2)
  notes             String?

  event   CateringEvent   @relation(fields: [cateringEventId], references: [id], onDelete: Cascade)
  service CateringService @relation(fields: [cateringServiceId], references: [id])

  @@index([cateringEventId])
}

model CateringMenuItem {
  id              Int     @id @default(autoincrement())
  cateringEventId Int
  menuItemId      Int
  quantity        Int
  unitPrice       Decimal @db.Decimal(10, 2)
  subtotal        Decimal @db.Decimal(10, 2)

  event    CateringEvent @relation(fields: [cateringEventId], references: [id], onDelete: Cascade)
  menuItem MenuItem      @relation(fields: [menuItemId], references: [id])

  @@index([cateringEventId])
  @@index([menuItemId])
}

model CateringPayment {
  id              Int                 @id @default(autoincrement())
  cateringEventId Int
  paymentMethodId Int
  methodType      PaymentMethodType
  amount          Decimal             @db.Decimal(10, 2)
  reference       String?
  idempotencyKey  String?             @db.VarChar(191)
  type            CateringPaymentType @default(ADVANCE)
  date            DateTime            @default(now())
  status          SalesPaymentStatus  @default(ACTIVE)
  registeredById  Int?
  reversedAt      DateTime?
  reversedById    Int?
  reversalReason  String?

  event         CateringEvent @relation(fields: [cateringEventId], references: [id], onDelete: Restrict)
  paymentMethod PaymentMethod @relation(fields: [paymentMethodId], references: [id])
  registeredBy  User?         @relation("CateringPaymentRegisteredBy", fields: [registeredById], references: [id], onDelete: Restrict)
  reversedBy    User?         @relation("CateringPaymentReversedBy", fields: [reversedById], references: [id], onDelete: Restrict)

  @@unique([cateringEventId, idempotencyKey])
  @@index([cateringEventId])
  @@index([methodType, date])
  @@index([status])
  @@index([registeredById])
  @@index([reversedById])
}

enum CateringPaymentType {
  ADVANCE
  FINAL_SETTLEMENT
}

/// Documento fiscal de Catering. La fila y su snapshot son inmutables después
/// de emisión; la secuencia se comparte con POS para evitar números duplicados.
model CateringFiscalInvoice {
  id              Int                 @id @default(autoincrement())
  companyId       Int
  branchId        Int
  cateringEventId Int                 @unique
  number          String              @unique @db.VarChar(80)
  status          InvoiceFiscalStatus @default(ISSUED)
  idempotencyKey  String              @db.VarChar(191)
  requestHash     String              @db.VarChar(64)
  subtotal        Decimal             @db.Decimal(10, 2)
  tax             Decimal             @db.Decimal(10, 2)
  total           Decimal             @db.Decimal(10, 2)
  snapshot        Json
  issuedAt        DateTime            @default(now())
  issuedById      Int
  createdAt       DateTime            @default(now())

  company    Company                   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  branch     Branch                    @relation(fields: [branchId], references: [id], onDelete: Restrict)
  event      CateringEvent             @relation(fields: [cateringEventId], references: [id], onDelete: Restrict)
  issuedBy   User                      @relation("CateringFiscalInvoiceIssuedBy", fields: [issuedById], references: [id], onDelete: Restrict)
  creditNote CateringFiscalCreditNote?

  @@unique([companyId, idempotencyKey])
  @@index([companyId, branchId, issuedAt])
  @@index([issuedById])
}

/// Contraflujo fiscal completo para Catering. No modela devoluciones parciales:
/// todo importe, pago e inventario del evento se reconcilia en una transacción.
model CateringFiscalCreditNote {
  id                      Int                            @id @default(autoincrement())
  companyId               Int
  branchId                Int
  cateringEventId         Int                            @unique
  cateringFiscalInvoiceId Int                            @unique
  number                  String                         @unique @db.VarChar(80)
  series                  String                         @db.VarChar(20)
  sequenceNumber          Int
  status                  FiscalCreditNoteStatus         @default(ISSUED)
  originalInvoiceNumber   String                         @db.VarChar(80)
  reason                  String                         @db.VarChar(500)
  jurisdiction            String                         @db.VarChar(32)
  idempotencyKey          String                         @db.VarChar(191)
  requestHash             String                         @db.VarChar(64)
  subtotal                Decimal                        @db.Decimal(10, 2)
  tax                     Decimal                        @db.Decimal(10, 2)
  total                   Decimal                        @db.Decimal(10, 2)
  inventoryDisposition    CreditNoteInventoryDisposition
  snapshot                Json
  issuedAt                DateTime                       @default(now())
  issuedById              Int
  createdAt               DateTime                       @default(now())

  company  Company               @relation(fields: [companyId], references: [id], onDelete: Restrict)
  branch   Branch                @relation(fields: [branchId], references: [id], onDelete: Restrict)
  event    CateringEvent         @relation(fields: [cateringEventId], references: [id], onDelete: Restrict)
  invoice  CateringFiscalInvoice @relation(fields: [cateringFiscalInvoiceId], references: [id], onDelete: Restrict)
  issuedBy User                  @relation("CateringFiscalCreditNoteIssuedBy", fields: [issuedById], references: [id], onDelete: Restrict)

  @@unique([companyId, idempotencyKey])
  @@unique([companyId, branchId, series, sequenceNumber])
  @@index([companyId, branchId, issuedAt])
  @@index([originalInvoiceNumber])
  @@index([issuedById])
}

// ==========================================
// 13. AUDIT LOG
// ==========================================

model AuditLog {
  id         Int      @id @default(autoincrement())
  // Nullable + optional relation so the FK can be added without backfilling
  // pre-existing rows. DEFERRED: making companyId required again needs a backfill.
  companyId  Int?
  entityType String // Order, Payment, InventoryMovement, etc.
  entityId   Int
  action     String // CANCEL, CREATE, UPDATE, DELETE, TRANSFER, etc.
  userId     Int
  details    Json? // Additional context (reason, old/new values, etc.)
  createdAt  DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id])
  company Company? @relation(fields: [companyId], references: [id])

  @@index([companyId, entityType, entityId])
  @@index([companyId, createdAt])
  @@index([userId])
}

// Durable cross-instance HTTP idempotency ledger.
model IdempotencyRecord {
  id          Int      @id @default(autoincrement())
  namespace   String   @db.VarChar(64)
  scope       String   @db.VarChar(191)
  key         String   @db.VarChar(191)
  fingerprint String   @db.Char(64)
  status      String   @db.VarChar(20)
  httpStatus  Int?
  response    Json?
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([namespace, scope, key])
  @@index([expiresAt])
}

// ==========================================
// 14. API KEYS
// ==========================================

model ApiKey {
  id         Int       @id @default(autoincrement())
  companyId  Int
  name       String
  keyHash    String    @unique
  keyPrefix  String
  scopes     Json      @default("[]")
  active     Boolean   @default(true)
  expiresAt  DateTime?
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  createdBy  Int?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  creator User?   @relation("ApiKeyCreator", fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([companyId])
}

// ==========================================
// 15. PEDIDOSYA INTEGRATION
// ==========================================

model PedidosYaConfig {
  id                 Int       @id @default(autoincrement())
  companyId          Int
  branchId           Int?
  clientId           String?
  clientSecret       String?
  restaurantId       String?
  webhookSecret      String?
  environment        String    @default("sandbox") // sandbox | production
  autoAcceptOrders   Boolean   @default(false)
  autoSyncStatus     Boolean   @default(true)
  defaultWarehouseId Int?
  active             Boolean   @default(false)
  accessToken        String?   @db.Text
  refreshToken       String?   @db.Text
  tokenExpiresAt     DateTime?
  lastSyncAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  company   Company    @relation(fields: [companyId], references: [id])
  branch    Branch?    @relation(fields: [branchId], references: [id])
  warehouse Warehouse? @relation(fields: [defaultWarehouseId], references: [id])

  @@unique([companyId, branchId])
  @@index([companyId])
}

model PedidosYaProductMapping {
  id           Int       @id @default(autoincrement())
  companyId    Int
  externalId   String
  externalName String
  menuItemId   Int?
  isActive     Boolean   @default(true)
  lastSyncAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  company  Company   @relation(fields: [companyId], references: [id])
  menuItem MenuItem? @relation(fields: [menuItemId], references: [id])

  @@unique([companyId, externalId])
  @@index([companyId])
  @@index([menuItemId])
}

model PedidosYaWebhookLog {
  id           Int       @id @default(autoincrement())
  companyId    Int
  eventType    String
  externalId   String?
  payload      Json
  status       String    @default("RECEIVED") // RECEIVED | PROCESSED | FAILED | IGNORED
  errorMessage String?   @db.Text
  processedAt  DateTime?
  createdAt    DateTime  @default(now())

  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId, createdAt])
  @@index([externalId])
}

model PedidosYaOrderSync {
  id             Int      @id @default(autoincrement())
  companyId      Int
  orderId        Int
  externalId     String
  externalStatus String?
  internalStatus String?
  lastSyncAt     DateTime @default(now())
  syncDirection  String   @default("INBOUND") // INBOUND | OUTBOUND
  metadata       Json?
  createdAt      DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id])
  order   Order   @relation(fields: [orderId], references: [id])

  @@unique([companyId, externalId])
  @@index([companyId, orderId])
}

// Consolidating Customers
model Customer {
  id        Int      @id @default(autoincrement())
  companyId Int
  name      String
  email     String?
  phone     String?
  address   String?  @db.Text
  taxId     String? // RUC/NIT
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company        Company         @relation(fields: [companyId], references: [id])
  cateringEvents CateringEvent[]

  @@index([companyId])
}

// ==========================================
// 16. PRODUCCIÓN (RECETAS BOM Y ÓRDENES)
// ==========================================
//
// Distinto del modelo `Recipe` (MenuItem -> Product, consumo en venta).
// Aquí una receta de producción (ProductionRecipe) está asociada a un PRODUCTO
// de salida (intermedio o terminado) y se compone de varios componentes que son
// otros productos del inventario (insumos comprados, intermedios o empaques),
// permitiendo recetas multinivel.

enum ProductionRecipeStatus {
  DRAFT // Borrador (editable, no usable en producción)
  ACTIVE // Activa (versión vigente para producir)
  INACTIVE // Inactiva / archivada (versión anterior)
}

model ProductionRecipe {
  id            Int                    @id @default(autoincrement())
  companyId     Int
  productId     Int // Producto de salida (INTERMEDIATE o PRODUCT_FOR_SALE)
  name          String
  version       Int                    @default(1)
  status        ProductionRecipeStatus @default(DRAFT)
  yieldQuantity Decimal                @db.Decimal(18, 6) // Rendimiento: cantidad producida por lote (en yieldUnit)
  yieldUnitId   Int?
  notes         String?                @db.Text
  createdById   Int?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  company          Company                     @relation(fields: [companyId], references: [id])
  product          Product                     @relation("ProductProductionRecipes", fields: [productId], references: [id])
  yieldUnit        UnitOfMeasure?              @relation("ProductionRecipeYieldUnit", fields: [yieldUnitId], references: [id])
  createdBy        User?                       @relation("ProductionRecipeCreatedBy", fields: [createdById], references: [id])
  components       ProductionRecipeComponent[]
  productionOrders ProductionOrder[]

  @@unique([companyId, productId, version])
  @@index([companyId])
  @@index([productId])
  @@index([companyId, status])
}

model ProductionRecipeComponent {
  id                 Int     @id @default(autoincrement())
  recipeId           Int
  componentProductId Int
  quantity           Decimal @db.Decimal(18, 6) // Cantidad por lote (rendimiento) en `unit`
  unitId             Int?
  unit               String?
  notes              String?

  recipe           ProductionRecipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  componentProduct Product          @relation("ProductRecipeComponents", fields: [componentProductId], references: [id])
  unitOfMeasure    UnitOfMeasure?   @relation("ProductionRecipeComponentUnit", fields: [unitId], references: [id])

  @@unique([recipeId, componentProductId])
  @@index([recipeId])
  @@index([componentProductId])
}

enum ProductionOrderStatus {
  DRAFT // Borrador
  PENDING // Pendiente (planificada, insumos reservados conceptualmente)
  IN_PROGRESS // En proceso
  FINISHED // Finalizada (insumos descargados, producto ingresado)
  CANCELLED // Anulada
}

model ProductionOrder {
  id                Int                   @id @default(autoincrement())
  companyId         Int
  branchId          Int
  code              String // Número/código de orden (PRD-000001)
  productId         Int // Producto a producir
  recipeId          Int? // Receta utilizada (snapshot lógico)
  warehouseId       Int // Almacén donde se consumen insumos y entra el producido
  status            ProductionOrderStatus @default(DRAFT)
  plannedQuantity   Decimal               @db.Decimal(18, 6) // Cantidad planificada
  producedQuantity  Decimal               @default(0) @db.Decimal(18, 6) // Cantidad real producida
  estimatedCost     Decimal               @default(0) @db.Decimal(18, 6) // Costo estimado total
  estimatedUnitCost Decimal               @default(0) @db.Decimal(18, 6)
  realCost          Decimal               @default(0) @db.Decimal(18, 6) // Costo real total (insumos consumidos)
  realUnitCost      Decimal               @default(0) @db.Decimal(18, 6) // Costo unitario real del producido
  userId            Int // Usuario responsable
  notes             String?               @db.Text
  date              DateTime              @default(now())
  startedAt         DateTime?
  finishedAt        DateTime?
  cancelledAt       DateTime?
  cancelledById     Int?
  cancelReason      String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  company     Company               @relation(fields: [companyId], references: [id])
  branch      Branch                @relation(fields: [branchId], references: [id])
  product     Product               @relation("ProductProductionOrders", fields: [productId], references: [id])
  recipe      ProductionRecipe?     @relation(fields: [recipeId], references: [id])
  warehouse   Warehouse             @relation(fields: [warehouseId], references: [id])
  user        User                  @relation("ProductionOrderUser", fields: [userId], references: [id])
  cancelledBy User?                 @relation("ProductionOrderCancelledBy", fields: [cancelledById], references: [id])
  items       ProductionOrderItem[]
  costHistory ProductCostHistory[]

  @@unique([companyId, code])
  @@index([companyId, branchId])
  @@index([companyId, status])
  @@index([productId])
  @@index([recipeId])
}

model ProductionOrderItem {
  id                 Int     @id @default(autoincrement())
  productionOrderId  Int
  componentProductId Int
  requiredQuantity   Decimal @db.Decimal(18, 6) // Insumo requerido (en unidad base del componente)
  consumedQuantity   Decimal @default(0) @db.Decimal(18, 6) // Insumo consumido real (en unidad base)
  unitId             Int?
  unit               String?
  unitCost           Decimal @default(0) @db.Decimal(18, 6) // Costo unitario al consumir (promedio ponderado)
  totalCost          Decimal @default(0) @db.Decimal(18, 6)
  // Exact FIFO portions consumed when the order is finished. Required to restore
  // the original layer costs/order on cancellation instead of reopening one
  // averaged layer. Null on legacy/uncompleted orders.
  consumedLayers     Json?

  productionOrder  ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  componentProduct Product         @relation("ProductProductionOrderItems", fields: [componentProductId], references: [id])
  unitOfMeasure    UnitOfMeasure?  @relation("ProductionOrderItemUnit", fields: [unitId], references: [id])

  @@index([productionOrderId])
  @@index([componentProductId])
}

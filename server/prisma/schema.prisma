model ShiftTemplate {
  id            Int      @id @default(autoincrement())
  companyId     Int
  branchId      Int
  jobPositionId Int?
  name          String
  code          String
  startMinute   Int
  endMinute     Int
  breakMinutes  Int      @default(0)
  paidBreak     Boolean  @default(false)
  timezone      String   @db.VarChar(64)
  notes         String?  @db.Text
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company     Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  branch      Branch           @relation(fields: [branchId], references: [id], onDelete: Restrict)
  jobPosition JobPosition?     @relation(fields: [jobPositionId], references: [id], onDelete: SetNull)
  shifts      ScheduledShift[]

  @@unique([companyId, code])
  @@index([companyId, branchId, active])
  @@index([jobPositionId])
}

model WeeklySchedule {
  id                   Int                  @id @default(autoincrement())
  companyId            Int
  weekStart            DateTime             @db.Date
  version              Int
  revision             Int                  @default(0)
  status               WeeklyScheduleStatus @default(DRAFT)
  publicationKey       String?              @db.VarChar(64)
  supersedesScheduleId Int?
  createdById          Int
  publishedById        Int?
  publishedAt          DateTime?
  supersededAt         DateTime?
  cancelledAt          DateTime?
  notes                String?              @db.Text
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  company            Company                   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  createdBy          User                      @relation("WeeklyScheduleCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  publishedBy        User?                     @relation("WeeklySchedulePublishedBy", fields: [publishedById], references: [id], onDelete: Restrict)
  supersedesSchedule WeeklySchedule?           @relation("WeeklyScheduleSupersession", fields: [supersedesScheduleId], references: [id], onDelete: Restrict)
  supersededBy       WeeklySchedule[]          @relation("WeeklyScheduleSupersession")
  shifts             ScheduledShift[]
  acknowledgements   ScheduleAcknowledgement[]
  swapRequests       ShiftSwapRequest[]

  @@unique([companyId, publicationKey])
  @@unique([companyId, weekStart, version])
  @@index([companyId, weekStart, status])
  @@index([supersedesScheduleId])
  @@index([createdById])
  @@index([publishedById])
}

enum WeeklyScheduleStatus {
  DRAFT
  PUBLISHED
  SUPERSEDED
  CANCELLED
}

model ScheduledShift {
  id               Int                  @id @default(autoincrement())
  companyId        Int
  scheduleId       Int
  userId           Int
  branchId         Int
  jobPositionId    Int?
  shiftTemplateId  Int?
  startAt          DateTime
  endAt            DateTime
  timezoneSnapshot String               @db.VarChar(64)
  breakMinutes     Int                  @default(0)
  paidBreak        Boolean              @default(false)
  notes            String?              @db.Text
  status           ScheduledShiftStatus @default(SCHEDULED)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  company               Company                  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  schedule              WeeklySchedule           @relation(fields: [scheduleId], references: [id], onDelete: Restrict)
  user                  User                     @relation(fields: [userId], references: [id], onDelete: Restrict)
  branch                Branch                   @relation(fields: [branchId], references: [id], onDelete: Restrict)
  jobPosition           JobPosition?             @relation(fields: [jobPositionId], references: [id], onDelete: SetNull)
  shiftTemplate         ShiftTemplate?           @relation(fields: [shiftTemplateId], references: [id], onDelete: SetNull)
  requesterSwapRequests ShiftSwapRequest[]       @relation("SwapRequesterShift")
  offeredSwapRequests   ShiftSwapRequest[]       @relation("SwapOfferedShift")
  assignmentOverride    ShiftAssignmentOverride?
  swapReservation       ShiftSwapReservation?
  attendanceEvents      AttendanceEvent[]

  @@index([companyId, userId, startAt])
  @@index([scheduleId, status])
  @@index([branchId, startAt])
  @@index([jobPositionId])
  @@index([shiftTemplateId])
}

enum ScheduledShiftStatus {
  SCHEDULED
  CANCELLED
}

model ScheduleAcknowledgement {
  id             Int      @id @default(autoincrement())
  companyId      Int
  scheduleId     Int
  userId         Int
  acknowledgedAt DateTime @default(now())

  company  Company        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  schedule WeeklySchedule @relation(fields: [scheduleId], references: [id], onDelete: Restrict)
  user     User           @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([scheduleId, userId])
  @@index([companyId, userId, acknowledgedAt])
}

model HolidayCalendar {
  id        Int      @id @default(autoincrement())
  companyId Int
  name      String
  timezone  String   @db.VarChar(64)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  holidays Holiday[]

  @@unique([companyId, name])
  @@index([companyId, active])
}

model Holiday {
  id            Int      @id @default(autoincrement())
  companyId     Int
  calendarId    Int
  branchId      Int?
  scopeKey      String   @db.VarChar(32)
  name          String
  date          DateTime @db.Date
  paid          Boolean  @default(true)
  payMultiplier Decimal  @default(1) @db.Decimal(5, 2)
  notes         String?  @db.Text
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company  Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  calendar HolidayCalendar @relation(fields: [calendarId], references: [id], onDelete: Restrict)
  branch   Branch?         @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@unique([calendarId, date, scopeKey])
  @@index([companyId, date, active])
  @@index([branchId, date])
}

model ShiftSwapRequest {
  id                Int                    @id @default(autoincrement())
  companyId         Int
  scheduleId        Int
  requesterShiftId  Int
  offeredShiftId    Int?
  requestedById     Int
  targetUserId      Int
  status            ShiftSwapRequestStatus @default(PENDING)
  reason            String?                @db.Text
  targetRespondedAt DateTime?
  decidedById       Int?
  decidedAt         DateTime?
  decisionNotes     String?                @db.Text
  openRequesterKey  String?                @unique @db.VarChar(64)
  openOfferedKey    String?                @unique @db.VarChar(64)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  company        Company                   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  schedule       WeeklySchedule            @relation(fields: [scheduleId], references: [id], onDelete: Restrict)
  requesterShift ScheduledShift            @relation("SwapRequesterShift", fields: [requesterShiftId], references: [id], onDelete: Restrict)
  offeredShift   ScheduledShift?           @relation("SwapOfferedShift", fields: [offeredShiftId], references: [id], onDelete: Restrict)
  requestedBy    User                      @relation("ShiftSwapRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  targetUser     User                      @relation("ShiftSwapTargetUser", fields: [targetUserId], references: [id], onDelete: Restrict)
  decidedBy      User?                     @relation("ShiftSwapDecidedBy", fields: [decidedById], references: [id], onDelete: Restrict)
  assignments    ShiftAssignmentOverride[]
  reservations   ShiftSwapReservation[]

  @@index([companyId, status, createdAt])
  @@index([scheduleId])
  @@index([requestedById, status])
  @@index([targetUserId, status])
  @@index([requesterShiftId])
  @@index([offeredShiftId])
  @@index([decidedById])
}

model ShiftSwapReservation {
  id               Int      @id @default(autoincrement())
  companyId        Int
  swapRequestId    Int
  scheduledShiftId Int      @unique
  createdAt        DateTime @default(now())

  company        Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  swapRequest    ShiftSwapRequest @relation(fields: [swapRequestId], references: [id], onDelete: Restrict)
  scheduledShift ScheduledShift   @relation(fields: [scheduledShiftId], references: [id], onDelete: Restrict)

  @@unique([swapRequestId, scheduledShiftId])
  @@index([companyId, createdAt])
  @@index([swapRequestId])
}

// A published shift remains immutable. An approved, audited swap changes its
// effective assignee through this ledger row instead of overwriting userId.
model ShiftAssignmentOverride {
  id               Int      @id @default(autoincrement())
  companyId        Int
  scheduledShiftId Int      @unique
  assignedUserId   Int
  swapRequestId    Int
  assignedById     Int
  effectiveAt      DateTime @default(now())
  createdAt        DateTime @default(now())

  company        Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  scheduledShift ScheduledShift   @relation(fields: [scheduledShiftId], references: [id], onDelete: Restrict)
  assignedUser   User             @relation("ShiftAssignmentAssignedUser", fields: [assignedUserId], references: [id], onDelete: Restrict)
  swapRequest    ShiftSwapRequest @relation(fields: [swapRequestId], references: [id], onDelete: Restrict)
  assignedBy     User             @relation("ShiftAssignmentAssignedBy", fields: [assignedById], references: [id], onDelete: Restrict)

  @@index([companyId, assignedUserId, effectiveAt])
  @@index([swapRequestId])
  @@index([assignedById])
}

enum ShiftSwapRequestStatus {
  PENDING
  ACCEPTED
  APPROVED
  REJECTED
  CANCELLED
}

model AttendancePolicy {
  id                       Int                       @id @default(autoincrement())
  companyId                Int
  branchId                 Int?
  scopeKey                 String                    @db.VarChar(64)
  currentKey               String?                   @db.VarChar(64)
  version                  Int
  timezone                 String                    @db.VarChar(64)
  requireBiometric         Boolean                   @default(true)
  requireLiveness          Boolean                   @default(true)
  requireGeolocation       Boolean                   @default(true)
  maxLocationAccuracyM     Int                       @default(50)
  earlyCheckInMinutes      Int                       @default(60)
  lateCheckInToleranceM    Int                       @default(10)
  earlyCheckOutToleranceM  Int                       @default(15)
  lateCheckOutMinutes      Int                       @default(240)
  scheduleViolationMode    AttendanceEnforcementMode @default(REVIEW)
  geofenceViolationMode    AttendanceEnforcementMode @default(BLOCK)
  biometricViolationMode   AttendanceEnforcementMode @default(BLOCK)
  allowUnscheduledPunch    Boolean                   @default(false)
  unscheduledViolationMode AttendanceEnforcementMode @default(REVIEW)
  allowManualFallback      Boolean                   @default(true)
  biometricConsentVersion  String                    @db.VarChar(64)
  biometricRetentionDays   Int                       @default(365)
  biometricRetentionNotice String?                   @db.Text
  active                   Boolean                   @default(true)
  createdById              Int
  createdAt                DateTime                  @default(now())
  supersededAt             DateTime?

  company   Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  branch    Branch?           @relation(fields: [branchId], references: [id], onDelete: Restrict)
  createdBy User              @relation("AttendancePolicyCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  events    AttendanceEvent[]

  @@unique([companyId, scopeKey, version])
  @@unique([companyId, currentKey])
  @@index([companyId, branchId, active])
  @@index([createdById])
}

enum AttendanceEnforcementMode {
  BLOCK
  REVIEW
  WARN
}

model BiometricProfile {
  id                 Int                    @id @default(autoincrement())
  companyId          Int
  userId             Int                    @unique
  status             BiometricProfileStatus @default(PENDING)
  consentVersion     String                 @db.VarChar(64)
  consentedAt        DateTime
  provider           String                 @db.VarChar(64)
  model              String                 @db.VarChar(128)
  templateRef        String                 @db.Text
  enrolledAt         DateTime?
  retentionExpiresAt DateTime?
  purgeRequestedAt   DateTime?
  revokedAt          DateTime?
  revocationReason   String?                @db.Text
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  company       Company                 @relation(fields: [companyId], references: [id], onDelete: Restrict)
  user          User                    @relation(fields: [userId], references: [id], onDelete: Restrict)
  events        AttendanceEvent[]
  purgeRequests BiometricPurgeRequest[]

  @@index([companyId, status])
}

enum BiometricProfileStatus {
  PENDING
  ACTIVE
  REVOKED
}

model BiometricChallenge {
  id              String                    @id @default(uuid())
  companyId       Int
  userId          Int
  purpose         BiometricChallengePurpose
  action          AttendanceAction?
  tokenHash       String                    @db.VarChar(64)
  nonce           String                    @db.VarChar(64)
  expiresAt       DateTime
  usedAt          DateTime?
  usedByKey       String?                   @db.VarChar(128)
  usedRequestHash String?                   @db.VarChar(64)
  attempts        Int                       @default(0)
  maxAttempts     Int                       @default(3)
  createdAt       DateTime                  @default(now())

  company Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  user    User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  event   AttendanceEvent?

  @@index([companyId, userId, purpose, expiresAt])
  @@index([expiresAt, usedAt])
}

enum BiometricChallengePurpose {
  ATTENDANCE_PUNCH
  BIOMETRIC_ENROLLMENT
}

enum AttendancePunchRequestStatus {
  PROCESSING
  COMPLETED
}

// Durable claim created before consuming a biometric challenge. It prevents a
// concurrent loser from persisting a rejection as the canonical idempotent result.
model AttendancePunchRequest {
  id             Int                          @id @default(autoincrement())
  companyId      Int
  userId         Int
  idempotencyKey String                       @db.VarChar(128)
  requestHash    String                       @db.VarChar(64)
  challengeId    String                       @db.VarChar(191)
  status         AttendancePunchRequestStatus @default(PROCESSING)
  leaseExpiresAt DateTime
  eventId        Int?                         @unique
  attempts       Int                          @default(1)
  lastError      String?                      @db.VarChar(191)
  createdAt      DateTime                     @default(now())
  updatedAt      DateTime                     @updatedAt

  company Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  user    User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  event   AttendanceEvent? @relation(fields: [eventId], references: [id], onDelete: Restrict)

  @@unique([companyId, idempotencyKey])
  @@index([companyId, status, leaseExpiresAt])
  @@index([userId, createdAt])
}

enum BiometricPurgeRequestStatus {
  PENDING
  COMPLETED
  FAILED
}

// The prior provider reference remains encrypted only while an external purge
// is pending. Local consent withdrawal never waits for provider availability.
model BiometricPurgeRequest {
  id                   Int                         @id @default(autoincrement())
  companyId            Int
  biometricProfileId   Int
  provider             String                      @db.VarChar(64)
  encryptedTemplateRef String                      @db.Text
  reason               String                      @db.VarChar(64)
  status               BiometricPurgeRequestStatus @default(PENDING)
  attempts             Int                         @default(0)
  nextAttemptAt        DateTime?
  lastError            String?                     @db.Text
  createdAt            DateTime                    @default(now())
  completedAt          DateTime?

  company Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  profile BiometricProfile @relation(fields: [biometricProfileId], references: [id], onDelete: Restrict)

  @@index([companyId, status, nextAttemptAt])
  @@index([biometricProfileId, createdAt])
}

model AttendanceDevice {
  id          Int                    @id @default(autoincrement())
  companyId   Int
  branchId    Int
  name        String                 @db.VarChar(100)
  code        String                 @db.VarChar(50)
  keyHash     String                 @db.VarChar(64)
  status      AttendanceDeviceStatus @default(ACTIVE)
  createdById Int
  revokedById Int?
  revokedAt   DateTime?
  lastSeenAt  DateTime?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  company   Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  branch    Branch            @relation(fields: [branchId], references: [id], onDelete: Restrict)
  createdBy User              @relation("AttendanceDeviceCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  revokedBy User?             @relation("AttendanceDeviceRevokedBy", fields: [revokedById], references: [id], onDelete: Restrict)
  events    AttendanceEvent[]

  @@unique([companyId, code])
  @@index([companyId, branchId, status])
  @@index([createdById])
  @@index([revokedById])
}

enum AttendanceDeviceStatus {
  ACTIVE
  REVOKED
}

model AttendanceEvent {
  id                 Int                      @id @default(autoincrement())
  companyId          Int
  userId             Int

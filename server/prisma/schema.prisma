  cateringEvents CateringEvent[]

  @@index([companyId])
}

// ==========================================
// 16. PRODUCCIÓN (RECETAS BOM Y ÓRDENES)
// ==========================================
//
// Distinto del modelo `Recipe` (MenuItem -> Product, consumo en venta).
// Aquí una receta de producción (ProductionRecipe) está asociada a un PRODUCTO
// de salida (intermedio o terminado) y se compone de varios componentes que son
// otros productos del inventario (insumos comprados, intermedios o empaques),
// permitiendo recetas multinivel.

enum ProductionRecipeStatus {
  DRAFT // Borrador (editable, no usable en producción)
  ACTIVE // Activa (versión vigente para producir)
  INACTIVE // Inactiva / archivada (versión anterior)
}

model ProductionRecipe {
  id            Int                    @id @default(autoincrement())
  companyId     Int
  productId     Int // Producto de salida (INTERMEDIATE o PRODUCT_FOR_SALE)
  name          String
  version       Int                    @default(1)
  status        ProductionRecipeStatus @default(DRAFT)
  yieldQuantity Decimal                @db.Decimal(18, 6) // Rendimiento: cantidad producida por lote (en yieldUnit)
  yieldUnitId   Int?
  notes         String?                @db.Text
  createdById   Int?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  company          Company                     @relation(fields: [companyId], references: [id])
  product          Product                     @relation("ProductProductionRecipes", fields: [productId], references: [id])
  yieldUnit        UnitOfMeasure?              @relation("ProductionRecipeYieldUnit", fields: [yieldUnitId], references: [id])
  createdBy        User?                       @relation("ProductionRecipeCreatedBy", fields: [createdById], references: [id])
  components       ProductionRecipeComponent[]
  productionOrders ProductionOrder[]

  @@unique([companyId, productId, version])
  @@index([companyId])
  @@index([productId])
  @@index([companyId, status])
}

model ProductionRecipeComponent {
  id                 Int     @id @default(autoincrement())
  recipeId           Int
  componentProductId Int
  quantity           Decimal @db.Decimal(18, 6) // Cantidad por lote (rendimiento) en `unit`
  unitId             Int?
  unit               String?
  notes              String?

  recipe           ProductionRecipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  componentProduct Product          @relation("ProductRecipeComponents", fields: [componentProductId], references: [id])
  unitOfMeasure    UnitOfMeasure?   @relation("ProductionRecipeComponentUnit", fields: [unitId], references: [id])

  @@unique([recipeId, componentProductId])
  @@index([recipeId])
  @@index([componentProductId])
}

enum ProductionOrderStatus {
  DRAFT // Borrador
  PENDING // Pendiente (planificada, insumos reservados conceptualmente)
  IN_PROGRESS // En proceso
  FINISHED // Finalizada (insumos descargados, producto ingresado)
  CANCELLED // Anulada
}

model ProductionOrder {
  id                Int                   @id @default(autoincrement())
  companyId         Int
  branchId          Int
  code              String // Número/código de orden (PRD-000001)
  productId         Int // Producto a producir
  recipeId          Int? // Receta utilizada (snapshot lógico)
  warehouseId       Int // Almacén donde se consumen insumos y entra el producido
  status            ProductionOrderStatus @default(DRAFT)
  plannedQuantity   Decimal               @db.Decimal(18, 6) // Cantidad planificada
  producedQuantity  Decimal               @default(0) @db.Decimal(18, 6) // Cantidad real producida
  estimatedCost     Decimal               @default(0) @db.Decimal(18, 6) // Costo estimado total
  estimatedUnitCost Decimal               @default(0) @db.Decimal(18, 6)
  realCost          Decimal               @default(0) @db.Decimal(18, 6) // Costo real total (insumos consumidos)
  realUnitCost      Decimal               @default(0) @db.Decimal(18, 6) // Costo unitario real del producido
  userId            Int // Usuario responsable
  notes             String?               @db.Text
  date              DateTime              @default(now())
  startedAt         DateTime?
  finishedAt        DateTime?
  cancelledAt       DateTime?
  cancelledById     Int?
  cancelReason      String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  company     Company               @relation(fields: [companyId], references: [id])
  branch      Branch                @relation(fields: [branchId], references: [id])
  product     Product               @relation("ProductProductionOrders", fields: [productId], references: [id])
  recipe      ProductionRecipe?     @relation(fields: [recipeId], references: [id])
  warehouse   Warehouse             @relation(fields: [warehouseId], references: [id])
  user        User                  @relation("ProductionOrderUser", fields: [userId], references: [id])
  cancelledBy User?                 @relation("ProductionOrderCancelledBy", fields: [cancelledById], references: [id])
  items       ProductionOrderItem[]

  @@unique([companyId, code])
  @@index([companyId, branchId])
  @@index([companyId, status])
  @@index([productId])
  @@index([recipeId])
}

model ProductionOrderItem {
  id                 Int     @id @default(autoincrement())
  productionOrderId  Int
  componentProductId Int
  requiredQuantity   Decimal @db.Decimal(18, 6) // Insumo requerido (en unidad base del componente)
  consumedQuantity   Decimal @default(0) @db.Decimal(18, 6) // Insumo consumido real (en unidad base)
  unitId             Int?
  unit               String?
  unitCost           Decimal @default(0) @db.Decimal(18, 6) // Costo unitario al consumir (promedio ponderado)
  totalCost          Decimal @default(0) @db.Decimal(18, 6)

  productionOrder  ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  componentProduct Product         @relation("ProductProductionOrderItems", fields: [componentProductId], references: [id])
  unitOfMeasure    UnitOfMeasure?  @relation("ProductionOrderItemUnit", fields: [unitId], references: [id])

  @@index([productionOrderId])
  @@index([componentProductId])
}

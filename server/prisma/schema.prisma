  costCenter            CostCenter?                @relation(fields: [costCenterId], references: [id], onDelete: SetNull)
  supervisor            Employee?                  @relation("EmployeeSupervisor", fields: [supervisorEmployeeId], references: [id], onDelete: SetNull)
  directReports         Employee[]                 @relation("EmployeeSupervisor")
  contracts             EmploymentContract[]

  RESERVED
  PAID
  FINISHED
  CANCELLED
}

model CateringService {
  id           Int      @id @default(autoincrement())
  companyId    Int
  name         String
  description  String?  @db.Text
  internalCost Decimal  @default(0) @db.Decimal(10, 2)
  salePrice    Decimal  @default(0) @db.Decimal(10, 2)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company Company               @relation(fields: [companyId], references: [id])
  items   CateringServiceItem[]
}

model CateringServiceItem {
  id                Int     @id @default(autoincrement())
  cateringEventId   Int
  cateringServiceId Int
  quantity          Decimal @db.Decimal(10, 2)
  unitPrice         Decimal @db.Decimal(10, 2)
  subtotal          Decimal @db.Decimal(10, 2)
  notes             String?

  event   CateringEvent   @relation(fields: [cateringEventId], references: [id], onDelete: Cascade)
  service CateringService @relation(fields: [cateringServiceId], references: [id])

  @@index([cateringEventId])
}

model CateringMenuItem {
  id              Int     @id @default(autoincrement())
  cateringEventId Int
  menuItemId      Int
  quantity        Int
  unitPrice       Decimal @db.Decimal(10, 2)
  subtotal        Decimal @db.Decimal(10, 2)

  event    CateringEvent @relation(fields: [cateringEventId], references: [id], onDelete: Cascade)
  menuItem MenuItem      @relation(fields: [menuItemId], references: [id])

  @@index([cateringEventId])
  @@index([menuItemId])
}

model CateringPayment {
  id              Int                 @id @default(autoincrement())
  cateringEventId Int
  paymentMethodId Int
  amount          Decimal             @db.Decimal(10, 2)
  reference       String?
  type            CateringPaymentType @default(ADVANCE)
  date            DateTime            @default(now())

  event         CateringEvent @relation(fields: [cateringEventId], references: [id], onDelete: Restrict)
  paymentMethod PaymentMethod @relation(fields: [paymentMethodId], references: [id])


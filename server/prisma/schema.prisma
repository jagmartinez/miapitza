  supervisorEmployeeId         Int?
  notes                        String?        @db.Text
  createdAt                    DateTime       @default(now())
  updatedAt                    DateTime       @updatedAt

  company               Company                    @relation(fields: [companyId], references: [id], onDelete: Restrict)

// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ==========================================
// 0. CONTROL DE EMPRESAS (MULTI-TENANT)
// ==========================================

model Company {
  id                          Int           @id @default(autoincrement())
  name                        String
  ruc                         String?       @unique // Registro Único de Contribuyente (Nicaragua)
  logo                        String?
  /// Perfil fiscal maestro consumido por las versiones legales de nómina.
  payrollTaxRegime            String        @default("GENERAL") @db.VarChar(40)
  payrollIncomeTaxWithholding Boolean       @default(true)
  payrollTaxRegimeReference   String?       @db.VarChar(500)
  payrollIncomeTaxException   String?       @db.VarChar(500)
  payrollTaxProfileReady      Boolean       @default(false)
  costingMethod               CostingMethod @default(WEIGHTED_AVERAGE)
  active                      Boolean       @default(true)
  createdAt                   DateTime      @default(now())
  updatedAt                   DateTime      @updatedAt

  // Relations
  branches                        Branch[]
  settings                        Setting[]
  users                           User[]
  auditLogs                       AuditLog[]
  tables                          Table[]
  floorAreas                      FloorArea[]
  tableFloorPlans                 TableFloorPlan[]
  reservations                    Reservation[]
  categories                      Category[]
  menuBrands                      MenuBrand[]
  menuItems                       MenuItem[]
  products                        Product[]
  warehouses                      Warehouse[]
  suppliers                       Supplier[]
  purchaseOrders                  PurchaseOrder[]
  orders                          Order[]
  paymentMethods                  PaymentMethod[]
  cashRegisters                   CashRegister[]
  cashShifts                      CashShift[]
  modifierGroups                  ModifierGroup[]
  roles                           Role[]
  stocks                          Stock[]
  inventoryMovements              InventoryMovement[]
  cateringEvents                  CateringEvent[]
  cateringServices                CateringService[]
  customers                       Customer[]
  promotions                      Promotion[]
  productCostHistories            ProductCostHistory[]
  invoiceSequences                InvoiceSequence[]
  creditNoteSequences             CreditNoteSequence[]
  fiscalCreditNotes               FiscalCreditNote[]
  fiscalInvoiceCancellations      FiscalInvoiceCancellation[]
  cateringFiscalInvoices          CateringFiscalInvoice[]
  cateringFiscalCreditNotes       CateringFiscalCreditNote[]
  apiKeys                         ApiKey[]
  unitsOfMeasure                  UnitOfMeasure[]
  productUnits                    ProductUnit[]
  salesChannelConfigs             SalesChannelConfig[]
  pedidosYaConfigs                PedidosYaConfig[]
  pedidosYaMappings               PedidosYaProductMapping[]
  pedidosYaWebhookLogs            PedidosYaWebhookLog[]
  pedidosYaOrderSyncs             PedidosYaOrderSync[]
  productionRecipes               ProductionRecipe[]
  productionOrders                ProductionOrder[]
  inventoryBatches                InventoryBatch[]
  bankDeposits                    BankDeposit[]
  departments                     Department[]
  jobPositions                    JobPosition[]
  costCenters                     CostCenter[]
  employees                       Employee[]
  employmentContracts             EmploymentContract[]
  employeeBranches                EmployeeBranchAssignment[]
  compensationHistory             CompensationHistory[]
  geofenceVersions                BranchGeofenceVersion[]
  employeeDocuments               EmployeeDocument[]
  shiftTemplates                  ShiftTemplate[]
  weeklySchedules                 WeeklySchedule[]
  scheduledShifts                 ScheduledShift[]
  scheduleAcknowledgements        ScheduleAcknowledgement[]
  holidayCalendars                HolidayCalendar[]
  holidays                        Holiday[]
  shiftSwapRequests               ShiftSwapRequest[]
  shiftSwapReservations           ShiftSwapReservation[]
  shiftAssignmentOverrides        ShiftAssignmentOverride[]
  attendancePolicies              AttendancePolicy[]
  biometricProfiles               BiometricProfile[]
  biometricChallenges             BiometricChallenge[]
  attendanceDevices               AttendanceDevice[]
  attendanceEvents                AttendanceEvent[]
  attendanceReviews               AttendanceReview[]
  attendancePunchRequests         AttendancePunchRequest[]
  biometricPurgeRequests          BiometricPurgeRequest[]
  attendancePeriods               AttendancePeriod[]
  attendanceDailySummaries        AttendanceDailySummary[]
  attendanceIncidents             AttendanceIncident[]
  attendanceCorrections           AttendanceCorrection[]
  overtimeRequests                OvertimeRequest[]
  leaveTypes                      LeaveType[]
  leaveRequests                   LeaveRequest[]
  vacationBalances                VacationBalance[]
  vacationLedgerEntries           VacationLedgerEntry[]
  workforceIdempotency            WorkforceIdempotencyRecord[]
  payrollRules                    PayrollRuleVersion[]
  payrollPeriods                  PayrollPeriod[]
  payrollRuns                     PayrollRun[]
  payrollSnapshots                PayrollSnapshotLine[]
  payrollComponents               PayrollComponent[]
  payrollAnomalies                PayrollAnomaly[]
  payrollReceipts                 PayrollReceipt[]
  payrollReversals                PayrollRunReversal[]
  payrollTraces                   PayrollTrace[]
  payrollIdempotency              PayrollIdempotencyRecord[]
  payrollRuleConfigurations       PayrollRuleConfigurationRevision[]
  payrollRuleConfigurationReviews PayrollRuleConfigurationReview[]
  payrollAttendanceDependencies   PayrollAttendanceDependency[]
  payrollAguinaldoDependencies    PayrollAguinaldoSourceDependency[]
  payrollCoverageClaims           PayrollCoverageClaim[]
  payrollCoverageReleases         PayrollCoverageRelease[]
  payrollComponentReversals       PayrollComponentReversal[]
  payrollEmployerContributions    PayrollEmployerContribution[]
  payrollStatutoryCalculations    PayrollStatutoryCalculation[]
  payrollPayments                 PayrollPaymentRecord[]
  travelRequests                  HrTravelRequest[]
  travelExpenses                  HrTravelExpense[]
  travelLedger                    HrTravelLedgerEntry[]
  loans                           HrLoan[]
  loanScheduleVersions            HrLoanScheduleVersion[]
  loanInstallments                HrLoanInstallment[]
  loanLedger                      HrLoanLedgerEntry[]
  deductions                      HrDeduction[]
  deductionVersions               HrDeductionVersion[]
  deductionApplications           HrDeductionApplication[]
  benefitTraces                   HrBenefitTrace[]
  benefitIdempotency              HrBenefitIdempotencyRecord[]
  benefitPolicies                 HrBenefitPolicyVersion[]
  employmentSettlements           HrEmploymentSettlement[]
  employmentSettlementLines       HrEmploymentSettlementLine[]
  kitchenNotifications            KitchenNotification[]
}

enum CostingMethod {
  WEIGHTED_AVERAGE
  FIFO
}

// ==========================================
// 1. CONTROL DE SUCURSALES Y USUARIOS
// ==========================================

model Branch {
  id                   Int          @id @default(autoincrement())
  companyId            Int
  name                 String
  code                 String
  address              String?
  phone                String?
  latitude             Decimal?     @db.Decimal(10, 7)
  longitude            Decimal?     @db.Decimal(10, 7)
  geofenceRadiusM      Int?
  maxLocationAccuracyM Int?
  timezone             String       @default("America/Managua") @db.VarChar(64)
  attendanceEnabled    Boolean      @default(false)
  geofenceVersion      Int          @default(0)
  status               BranchStatus @default(ACTIVE)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  // Relations
  company                        Company                     @relation(fields: [companyId], references: [id])
  users                          User[]
  allowedUsers                   UserBranch[]
  tables                         Table[]
  floorAreas                     FloorArea[]
  tableFloorPlans                TableFloorPlan[]
  reservations                   Reservation[]
  warehouses                     Warehouse[]
  purchaseOrders                 PurchaseOrder[]
  orders                         Order[]
  cashRegisters                  CashRegister[]
  menuItems                      MenuItem[] // Optional: if menu varies by branch
  menuItemPrices                 MenuItemBranchPrice[]
  cateringEvents                 CateringEvent[]
  invoiceSequences               InvoiceSequence[]
  fiscalCreditNotes              FiscalCreditNote[]
  fiscalInvoiceCancellations     FiscalInvoiceCancellation[]
  cateringFiscalInvoices         CateringFiscalInvoice[]
  cateringFiscalCreditNotes      CateringFiscalCreditNote[]
  pedidosYaConfigs               PedidosYaConfig[]
  productionOrders               ProductionOrder[]
  employeeAssignments            EmployeeBranchAssignment[]
  geofenceVersions               BranchGeofenceVersion[]
  shiftTemplates                 ShiftTemplate[]
  scheduledShifts                ScheduledShift[]
  holidays                       Holiday[]
  attendancePolicies             AttendancePolicy[]
  attendanceDevices              AttendanceDevice[]
  attendanceEvents               AttendanceEvent[]
  attendanceDailySummaries       AttendanceDailySummary[]
  attendanceIncidents            AttendanceIncident[]
  requestedAttendanceCorrections AttendanceCorrection[]
  leaveRequests                  LeaveRequest[]
  payrollSnapshots               PayrollSnapshotLine[]
  kitchenNotifications           KitchenNotification[]
  travelRequests                 HrTravelRequest[]

  @@unique([companyId, code])
  @@index([companyId])
}

model InvoiceSequence {
  id         Int      @id @default(autoincrement())
  companyId  Int
  branchId   Int
  lastNumber Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])
  branch  Branch  @relation(fields: [branchId], references: [id])

  @@unique([companyId, branchId])
}

enum InvoiceFiscalStatus {
  NOT_ISSUED
  ISSUED
  PARTIALLY_CREDITED
  CREDITED
  CANCELLED
}

enum FiscalCreditNoteStatus {
  ISSUED
}

enum CreditNoteInventoryDisposition {
  NOT_CONSUMED
  NOT_RETURNED
  RETURNED_TO_ORIGINAL_STOCK
}

model CreditNoteSequence {
  id         Int      @id @default(autoincrement())
  companyId  Int
  series     String   @db.VarChar(20)
  lastNumber Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, series])
  @@index([companyId])
}

model FiscalCreditNote {
  id                    Int                            @id @default(autoincrement())
  companyId             Int
  branchId              Int
  orderId               Int
  number                String                         @unique @db.VarChar(80)
  series                String                         @db.VarChar(20)
  sequenceNumber        Int
  status                FiscalCreditNoteStatus         @default(ISSUED)
  originalInvoiceNumber String                         @db.VarChar(191)
  reason                String                         @db.VarChar(500)
  jurisdiction          String                         @db.VarChar(32)
  idempotencyKey        String                         @db.VarChar(191)
  requestHash           String                         @db.VarChar(64)
  subtotal              Decimal                        @db.Decimal(10, 2)
  tax                   Decimal                        @db.Decimal(10, 2)
  tipAmount             Decimal                        @db.Decimal(10, 2)
  total                 Decimal                        @db.Decimal(10, 2)
  inventoryDisposition  CreditNoteInventoryDisposition
  wasteWarehouseId      Int?
  snapshot              Json
  issuedAt              DateTime                       @default(now())
  issuedById            Int
  createdAt             DateTime                       @default(now())

  company        Company                         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  branch         Branch                          @relation(fields: [branchId], references: [id], onDelete: Restrict)
  order          Order                           @relation(fields: [orderId], references: [id], onDelete: Restrict)
  wasteWarehouse Warehouse?                      @relation(fields: [wasteWarehouseId], references: [id], onDelete: Restrict)
  issuedBy       User                            @relation("FiscalCreditNoteIssuedBy", fields: [issuedById], references: [id], onDelete: Restrict)
  lines          FiscalCreditNoteLine[]
  refunds        FiscalCreditNotePaymentRefund[]

  @@unique([companyId, idempotencyKey])
  @@unique([companyId, branchId, series, sequenceNumber])
  @@index([companyId, branchId, issuedAt])
  @@index([orderId, issuedAt])
  @@index([originalInvoiceNumber])
  @@index([issuedById])
}

model FiscalCreditNoteLine {
  id                 Int      @id @default(autoincrement())
  fiscalCreditNoteId Int
  orderItemId        Int
  quantity           Int
  grossSubtotal      Decimal  @db.Decimal(10, 2)
  discount           Decimal  @db.Decimal(10, 2)
  subtotal           Decimal  @db.Decimal(10, 2)
  tax                Decimal  @db.Decimal(10, 2)
  tipAmount          Decimal  @db.Decimal(10, 2)
  total              Decimal  @db.Decimal(10, 2)
  createdAt          DateTime @default(now())

  fiscalCreditNote FiscalCreditNote @relation(fields: [fiscalCreditNoteId], references: [id], onDelete: Restrict)
  orderItem        OrderItem        @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  @@unique([fiscalCreditNoteId, orderItemId])
  @@index([orderItemId])
}

model FiscalCreditNotePaymentRefund {
  id                 Int      @id @default(autoincrement())
  fiscalCreditNoteId Int
  paymentId          Int
  amount             Decimal  @db.Decimal(10, 2)
  reference          String   @db.VarChar(191)
  createdAt          DateTime @default(now())

  fiscalCreditNote FiscalCreditNote @relation(fields: [fiscalCreditNoteId], references: [id], onDelete: Restrict)
  payment          Payment          @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@unique([fiscalCreditNoteId, paymentId])
  @@index([paymentId, createdAt])
  @@index([reference])
}

model FiscalInvoiceCancellation {
  id                    Int      @id @default(autoincrement())
  companyId             Int
  branchId              Int
  orderId               Int      @unique
  originalInvoiceNumber String   @db.VarChar(191)
  reason                String   @db.VarChar(500)
  jurisdiction          String   @db.VarChar(32)
  idempotencyKey        String   @db.VarChar(191)
  requestHash           String   @db.VarChar(64)
  wasteWarehouseId      Int?
  snapshot              Json
  cancelledAt           DateTime @default(now())
  cancelledById         Int
  createdAt             DateTime @default(now())

  company        Company    @relation(fields: [companyId], references: [id], onDelete: Restrict)
  branch         Branch     @relation(fields: [branchId], references: [id], onDelete: Restrict)
  order          Order      @relation(fields: [orderId], references: [id], onDelete: Restrict)
  wasteWarehouse Warehouse? @relation(fields: [wasteWarehouseId], references: [id], onDelete: Restrict)
  cancelledBy    User       @relation("FiscalInvoiceCancelledBy", fields: [cancelledById], references: [id], onDelete: Restrict)

  @@unique([companyId, idempotencyKey])
  @@index([companyId, branchId, cancelledAt])
  @@index([originalInvoiceNumber])
  @@index([cancelledById])
}

enum BranchStatus {
  ACTIVE
  INACTIVE
}

model User {
  id                     Int             @id @default(autoincrement())
  companyId              Int? // Null for simple setups, non-null for enterprise
  name                   String
  email                  String          @unique
  username               String          @unique
  password               String // Hashed
  mustChangePassword     Boolean         @default(true)
  passwordChangedAt      DateTime?
  twoFactorSecret        String?
  twoFactorEnabled       Boolean         @default(false)
  twoFactorRecoveryCodes Json?
  twoFactorEnabledAt     DateTime?
  roleId                 Int
  branchId               Int? // Primary branch
  status                 UserStatus      @default(ACTIVE)
  accountType            UserAccountType @default(EXTERNAL)
  color                  String? // Hex color for visual identification (e.g. waiters)
  nif                    String?
  address                String?
  phone                  String?
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  // Relations
  company         Company?      @relation(fields: [companyId], references: [id])
  role            Role          @relation(fields: [roleId], references: [id])
  branch          Branch?       @relation(fields: [branchId], references: [id])
  sessions        UserSession[]
  userRoles       UserRole[]
  allowedBranches UserBranch[] // Branches a SUPERADMIN permits this user to be assigned to
  employee        Employee?

  // Operational relations
  orders                            Order[]                            @relation("OrderCreator")
  cancelledOrders                   Order[]                            @relation("OrderCancelledBy")
  kitchenStarts                     Order[]                            @relation("OrderKitchenStartedBy")
  kitchenReleases                   Order[]                            @relation("OrderKitchenReleasedBy")
  kitchenNotifications              KitchenNotification[]              @relation("KitchenNotificationRecipient")
  cashShifts                        CashShift[]
  movements                         InventoryMovement[]
  auditLogs                         AuditLog[]
  apiKeys                           ApiKey[]                           @relation("ApiKeyCreator")
  productionRecipesCreated          ProductionRecipe[]                 @relation("ProductionRecipeCreatedBy")
  productionOrders                  ProductionOrder[]                  @relation("ProductionOrderUser")
  cancelledProductionOrders         ProductionOrder[]                  @relation("ProductionOrderCancelledBy")
  bankDepositsCreated               BankDeposit[]                      @relation("BankDepositCreatedBy")
  bankDepositsReversed              BankDeposit[]                      @relation("BankDepositReversedBy")
  paymentsRegistered                Payment[]                          @relation("PaymentRegisteredBy")
  paymentsReversed                  Payment[]                          @relation("PaymentReversedBy")
  fiscalCreditNotesIssued           FiscalCreditNote[]                 @relation("FiscalCreditNoteIssuedBy")
  fiscalInvoicesCancelled           FiscalInvoiceCancellation[]        @relation("FiscalInvoiceCancelledBy")
  cateringFiscalInvoicesIssued      CateringFiscalInvoice[]            @relation("CateringFiscalInvoiceIssuedBy")
  cateringFiscalCreditNotesIssued   CateringFiscalCreditNote[]         @relation("CateringFiscalCreditNoteIssuedBy")
  cateringPaymentsRegistered        CateringPayment[]                  @relation("CateringPaymentRegisteredBy")
  cateringPaymentsReversed          CateringPayment[]                  @relation("CateringPaymentReversedBy")
  purchasePaymentsReversed          PurchaseOrderPayment[]             @relation("PurchaseOrderPaymentReversedBy")
  compensationChanges               CompensationHistory[]              @relation("CompensationChangedBy")
  geofenceChanges                   BranchGeofenceVersion[]            @relation("BranchGeofenceChangedBy")
  employeeDocumentsUploaded         EmployeeDocument[]                 @relation("EmployeeDocumentUploadedBy")
  scheduledShifts                   ScheduledShift[]
  schedulesCreated                  WeeklySchedule[]                   @relation("WeeklyScheduleCreatedBy")
  schedulesPublished                WeeklySchedule[]                   @relation("WeeklySchedulePublishedBy")
  scheduleAcknowledgements          ScheduleAcknowledgement[]
  swapRequestsCreated               ShiftSwapRequest[]                 @relation("ShiftSwapRequestedBy")
  swapRequestsTargeted              ShiftSwapRequest[]                 @relation("ShiftSwapTargetUser")
  swapRequestsDecided               ShiftSwapRequest[]                 @relation("ShiftSwapDecidedBy")
  shiftAssignmentsReceived          ShiftAssignmentOverride[]          @relation("ShiftAssignmentAssignedUser")
  shiftAssignmentsCreated           ShiftAssignmentOverride[]          @relation("ShiftAssignmentAssignedBy")
  attendancePoliciesCreated         AttendancePolicy[]                 @relation("AttendancePolicyCreatedBy")
  biometricProfile                  BiometricProfile?
  biometricChallenges               BiometricChallenge[]
  attendanceEvents                  AttendanceEvent[]                  @relation("AttendanceEventSubject")
  attendanceEventsCreated           AttendanceEvent[]                  @relation("AttendanceEventActor")
  attendanceReviews                 AttendanceReview[]                 @relation("AttendanceReviewReviewer")
  attendanceDevicesCreated          AttendanceDevice[]                 @relation("AttendanceDeviceCreatedBy")
  attendanceDevicesRevoked          AttendanceDevice[]                 @relation("AttendanceDeviceRevokedBy")
  attendancePunchRequests           AttendancePunchRequest[]
  attendancePeriodsCreated          AttendancePeriod[]                 @relation("AttendancePeriodCreatedBy")
  attendancePeriodsClosed           AttendancePeriod[]                 @relation("AttendancePeriodClosedBy")
  attendancePeriodsReopened         AttendancePeriod[]                 @relation("AttendancePeriodReopenedBy")
  attendanceDailySummaries          AttendanceDailySummary[]
  attendanceIncidents               AttendanceIncident[]               @relation("AttendanceIncidentSubject")
  attendanceIncidentsResolved       AttendanceIncident[]               @relation("AttendanceIncidentResolvedBy")
  attendanceCorrections             AttendanceCorrection[]             @relation("AttendanceCorrectionSubject")
  attendanceCorrectionsRequested    AttendanceCorrection[]             @relation("AttendanceCorrectionRequestedBy")
  attendanceCorrectionsDecided      AttendanceCorrection[]             @relation("AttendanceCorrectionDecidedBy")
  overtimeRequests                  OvertimeRequest[]                  @relation("OvertimeRequestSubject")
  overtimeRequestsCreated           OvertimeRequest[]                  @relation("OvertimeRequestRequestedBy")
  overtimeRequestsDecided           OvertimeRequest[]                  @relation("OvertimeRequestDecidedBy")
  leaveRequests                     LeaveRequest[]                     @relation("LeaveRequestSubject")
  leaveRequestsCreated              LeaveRequest[]                     @relation("LeaveRequestRequestedBy")
  leaveRequestsDecided              LeaveRequest[]                     @relation("LeaveRequestDecidedBy")
  vacationBalances                  VacationBalance[]
  vacationLedgerEntries             VacationLedgerEntry[]              @relation("VacationLedgerSubject")
  vacationLedgerActors              VacationLedgerEntry[]              @relation("VacationLedgerActor")
  payrollRulesCreated               PayrollRuleVersion[]               @relation("PayrollRuleCreatedBy")
  payrollRulesValidated             PayrollRuleVersion[]               @relation("PayrollRuleValidatedBy")
  payrollPeriodsCreated             PayrollPeriod[]                    @relation("PayrollPeriodCreatedBy")
  payrollRunsCreated                PayrollRun[]                       @relation("PayrollRunCreatedBy")
  payrollRunsCalculated             PayrollRun[]                       @relation("PayrollRunCalculatedBy")
  payrollRunsReviewed               PayrollRun[]                       @relation("PayrollRunReviewedBy")
  payrollRunsApproved               PayrollRun[]                       @relation("PayrollRunApprovedBy")
  payrollRunsPaid                   PayrollRun[]                       @relation("PayrollRunPaidBy")
  payrollRunsVoided                 PayrollRun[]                       @relation("PayrollRunVoidedBy")
  payrollSnapshotLines              PayrollSnapshotLine[]
  payrollComponents                 PayrollComponent[]                 @relation("PayrollComponentSubject")
  payrollComponentsCreated          PayrollComponent[]                 @relation("PayrollComponentCreatedBy")
  payrollAnomalies                  PayrollAnomaly[]                   @relation("PayrollAnomalySubject")
  payrollReceipts                   PayrollReceipt[]                   @relation("PayrollReceiptSubject")
  payrollReversalsCreated           PayrollRunReversal[]               @relation("PayrollRunReversalActor")
  payrollTraces                     PayrollTrace[]                     @relation("PayrollTraceActor")
  payrollRuleConfigurationsUploaded PayrollRuleConfigurationRevision[] @relation("PayrollRuleConfigurationUploader")
  payrollRuleConfigurationsReviewed PayrollRuleConfigurationReview[]   @relation("PayrollRuleConfigurationReviewer")
  payrollCoverageReleasesCreated    PayrollCoverageRelease[]           @relation("PayrollCoverageReleaseActor")
  payrollComponentReversalsCreated  PayrollComponentReversal[]         @relation("PayrollComponentReversalActor")
  payrollEmployerContributions      PayrollEmployerContribution[]      @relation("PayrollEmployerContributionSubject")
  payrollStatutoryCalculations      PayrollStatutoryCalculation[]      @relation("PayrollStatutoryCalculationSubject")
  payrollPaymentsCreated            PayrollPaymentRecord[]             @relation("PayrollPaymentActor")
  payrollCoverageClaims             PayrollCoverageClaim[]
  travelRequests                    HrTravelRequest[]                  @relation("HrTravelSubject")
  travelRequestsCreated             HrTravelRequest[]                  @relation("HrTravelCreator")
  travelExpensesCreated             HrTravelExpense[]                  @relation("HrTravelExpenseCreator")
  travelLedgerEntries               HrTravelLedgerEntry[]              @relation("HrTravelLedgerActor")
  loans                             HrLoan[]                           @relation("HrLoanSubject")
  loansCreated                      HrLoan[]                           @relation("HrLoanCreator")
  loanLedgerEntries                 HrLoanLedgerEntry[]                @relation("HrLoanLedgerActor")
  deductions                        HrDeduction[]                      @relation("HrDeductionSubject")
  deductionsCreated                 HrDeduction[]                      @relation("HrDeductionCreator")
  deductionApplicationsCreated      HrDeductionApplication[]           @relation("HrDeductionApplicationActor")
  benefitTraces                     HrBenefitTrace[]                   @relation("HrBenefitTraceActor")
  benefitPoliciesCreated            HrBenefitPolicyVersion[]           @relation("HrBenefitPolicyCreator")
  benefitPoliciesActivated          HrBenefitPolicyVersion[]           @relation("HrBenefitPolicyActivator")
  employmentSettlementsCreated      HrEmploymentSettlement[]           @relation("HrEmploymentSettlementCreator")
  employmentSettlements             HrEmploymentSettlement[]           @relation("HrEmploymentSettlementSubject")

  // DEFERRED (require data migration / backfill - NOT done in this additive pass):
  //  - email/username are globally @unique; making them tenant-scoped composite
  //    (@@unique([companyId, email]) / @@unique([companyId, username])) needs
  //    de-duplication of existing data first.
  //  - companyId is nullable for backward compatibility; making it required needs
  //    backfilling existing NULL rows before adding NOT NULL.
  @@index([companyId])
  @@index([branchId])
}

// Branches a user is permitted to work in. The user's currently active branch
// is `User.branchId` (set by a SUPERADMIN during rotation); it must be one of
// these permitted branches. Non-SUPERADMIN users only ever see their active branch.
model UserBranch {
  id        Int      @id @default(autoincrement())
  userId    Int
  branchId  Int
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([userId, branchId])
  @@index([branchId])
}

model UserSession {
  id        String   @id @default(uuid())
  userId    Int
  tokenHash String   @unique
  ipAddress String?
  userAgent String?
  device    String?
  createdAt DateTime @default(now())
  expiresAt DateTime
  revoked   Boolean  @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum UserAccountType {
  INTERNAL
  EXTERNAL
}

model UserRole {
  id     Int @id @default(autoincrement())
  userId Int
  roleId Int

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id])

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
}

model Role {
  id          Int     @id @default(autoincrement())
  companyId   Int?
  name        String // SUPERADMIN, ADMIN, WAITER, etc.
  description String?

  company     Company?     @relation(fields: [companyId], references: [id])
  users       User[]
  userRoles   UserRole[]
  permissions Permission[]

  @@unique([companyId, name])
}

model Permission {
  id          Int     @id @default(autoincrement())
  name        String  @unique // e.g., "create_order", "view_reports"
  description String?

  roles Role[]
}

// ==========================================
// 1B. RECURSOS HUMANOS - FUNDACION
// ==========================================

model Department {
  id          Int      @id @default(autoincrement())
  companyId   Int
  name        String
  code        String
  description String?
  active      Boolean  @default(true)

{
  "name": "server",
  "version": "1.0.0",
  "main": "index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "typecheck": "tsc --noEmit",
    "build": "prisma generate && tsc",
    "lint": "eslint .",
    "start": "node dist/index.js",
    "db:prepare-legacy": "ts-node prisma/prepare-legacy-schema.ts",
    "db:sync-legacy-indexes": "ts-node prisma/sync-legacy-indexes.ts",
    "seed:base": "ts-node prisma/seed.ts",
    "seed:central-warehouses": "ts-node prisma/bootstrap-central-warehouses.ts",
    "seed:features": "ts-node prisma/seed-feature-scenarios.ts",
    "seed:operational": "ts-node prisma/operational-seed.ts",
    "import:maestros": "ts-node prisma/import-maestros-miapitz.ts",
    "normalize:menu-recipe-catalog": "node dist/scripts/apply-recipe-catalog-map.js",
    "prepare:recipe-catalog": "node dist/scripts/prepare-recipe-catalog.js",
    "import:menu-recipes": "node dist/scripts/import-menu-recipes.js",
    "backup:recipes": "node dist/scripts/backup-recipe-data.js",
    "import:menu-prices": "ts-node prisma/update-menu-prices-from-pdf.ts",
    "import:merge-products": "ts-node prisma/merge-recipe-products.ts",
    "db:merge-bamboo": "tsx prisma/merge-bamboo-branches.ts",
    "db:dedupe-catalog": "tsx prisma/dedupe-catalog.ts",
    "test": "npm run test:unit",
    "test:unit": "jest --config jest.unit.config.cjs",
    "test:integration": "jest --config jest.integration.config.cjs --runInBand",
    "test:coverage": "jest --config jest.unit.config.cjs --coverage"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@jest/globals": "^30.2.0",
    "@swc/core": "^1.15.3",
    "@swc/jest": "^0.2.39",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.10.1",
    "@types/supertest": "^6.0.3",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/ws": "^8.18.1",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "jest": "^30.2.0",
    "prettier": "^3.6.2",
    "prisma": "^5.10.0",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.3"
  },
  "dependencies": {
    "@prisma/client": "^5.10.0",
    "@types/qrcode": "^1.5.6",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-rate-limit": "^8.3.2",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "jspdf": "^3.0.4",
    "jspdf-autotable": "^5.0.2",
    "multer": "^2.1.1",
    "mysql2": "^3.15.3",
    "otplib": "^13.3.0",
    "qrcode": "^1.5.4",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "ws": "^8.18.3"
  }
}

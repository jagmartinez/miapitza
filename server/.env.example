# Copy to .env for local development. On Railway, set these in the service Variables UI
# (or reference the MySQL plugin, e.g. DATABASE_URL from the database service).

NODE_ENV=development

# Prisma (MySQL). Railway: reference your MySQL plugin URL or paste mysql://...
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DATABASE"

# Required for JWT auth (use a long random string in production)
JWT_SECRET=change-me-in-production

# HTTP port (Railway sets PORT automatically — do not override there)
PORT=3001

# CORS: public URL of the web app (Railway client URL or local http://localhost:5173)
CLIENT_URL=http://localhost:5173

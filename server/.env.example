# Copy to .env for local development. On Railway, set these in the service Variables UI
# (or reference the MySQL plugin, e.g. DATABASE_URL from the database service).

NODE_ENV=development

# Prisma (MySQL). Railway: reference your MySQL plugin URL or paste mysql://...
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DATABASE"

# Required for JWT auth (use a long random string in production)
JWT_SECRET=

# HTTP port. Canonical app port is 3000 (matches docker-compose and the client's
# VITE_API_URL/VITE_WS_URL defaults). Railway sets PORT automatically — do not override there.
PORT=3000

# Hard deadline for every OAuth/status call to PedidosYa. Invalid values fail
# closed before opening a network request. Accepted range: 250..60000 ms.
PEDIDOSYA_HTTP_TIMEOUT_MS=8000
# Internal DB deadline for `/api/v1/health` (50..10000 ms).
READINESS_DB_TIMEOUT_MS=2000

# CORS: public URL of the web app (Railway client URL or local http://localhost:5173)
CLIENT_URL=http://localhost:5173

# 2FA encryption key for TOTP secrets at rest (64-char hex = 256 bits)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Required in production; startup fails closed when it is absent or invalid.
TWO_FA_ENCRYPTION_KEY=

# Facial verification is disabled by default and attendance endpoints fail
# closed with HTTP 503 when biometric verification is required.
# The bundled fake provider is only for tests/local development and additionally
# requires HR_ALLOW_FAKE_FACE_PROVIDER=true; it is rejected in production.
HR_FACE_PROVIDER=disabled
HR_ALLOW_FAKE_FACE_PROVIDER=false
HR_ATTENDANCE_KIOSK_ENABLED=false
# 64-char hexadecimal AES-256 key. Required whenever a face provider is enabled.
HR_BIOMETRIC_ENCRYPTION_KEY=

# Optional. Leave empty to fail closed and disable the global physical-backup API.
BACKUP_ADMIN_COMPANY_ID=

# Required in production. `single` pins every actor to its own company and
# disables cross-tenant operations. `multi` requires PLATFORM_ADMIN_COMPANY_ID.
PLATFORM_TENANCY_MODE=single

# In `multi` mode, only a primary-role SUPERADMIN whose home companyId equals
# this value may operate across tenants. Leave empty in `single` mode.
PLATFORM_ADMIN_COMPANY_ID=

# Root for durable uploads and backups. Defaults to process.cwd() locally.
# On Railway mount a persistent volume and set this to its mount path.
STORAGE_DIR=

# Demo fixture seeds are always forbidden with NODE_ENV=production. In a
# disposable non-production environment, set the explicit opt-in, a password
# accepted by the shared password policy, and the exact tenant scope.
ALLOW_DEMO_SEED=false
DEMO_SEED_PASSWORD=
DEMO_SEED_COMPANY_ID=
DEMO_SEED_BRANCH_ID=
DEMO_SEED_PRIMARY_BRANCH_CODE=
DEMO_SEED_SECONDARY_BRANCH_CODE=

# Optional tenant filter for `npm run audit:catering-cash-ledger`.
AUDIT_COMPANY_ID=

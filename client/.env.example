# Server API URL (Railway: use the public URL of your API service, e.g. https://xxx.up.railway.app/api)
VITE_API_URL=http://localhost:3001/api

# WebSocket URL (Railway: wss://xxx.up.railway.app — same host as API, TLS)
VITE_WS_URL=ws://localhost:3001

# Other configurations
VITE_APP_NAME="Restaurant System"

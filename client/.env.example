# Server API URL. Canonical app port is 3000 (matches docker-compose and server PORT).
# Railway: use the public URL of your API service, e.g. https://xxx.up.railway.app/api
VITE_API_URL=http://localhost:3000/api

# WebSocket URL (Railway: wss://xxx.up.railway.app — same host as API, TLS)
VITE_WS_URL=ws://localhost:3000

# Other configurations
VITE_APP_NAME="Restaurant System"
